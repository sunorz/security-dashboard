  /* Breathing indicators, modelled on an old phone's notification LED:
     the light itself slowly rises, holds at full brightness, fades down,
     then rests in the dark for the remainder of each cycle. */
  @keyframes breath-glow {
    0% { opacity: 0.35; box-shadow: 0 0 2px 0 var(--glow); }
    30% { opacity: 1; box-shadow: 0 0 7px 3px var(--glow); }
    46% { opacity: 1; box-shadow: 0 0 7px 3px var(--glow); }
    64% { opacity: 0.35; box-shadow: 0 0 2px 0 var(--glow); }
    100% { opacity: 0.35; box-shadow: 0 0 2px 0 var(--glow); }
  }
  @keyframes breath-glow-bad {
    0% { opacity: 0.35; box-shadow: 0 0 2px 0 var(--glow); }
    26% { opacity: 1; box-shadow: 0 0 7px 3px var(--glow); }
    40% { opacity: 1; box-shadow: 0 0 7px 3px var(--glow); }
    58% { opacity: 0.35; box-shadow: 0 0 2px 0 var(--glow); }
    100% { opacity: 0.35; box-shadow: 0 0 2px 0 var(--glow); }
  }
