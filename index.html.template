  @keyframes xswim { 0% { transform: translateX(0); animation-timing-function: linear; } 2.1% { transform: translateX(-5px); animation-timing-function: linear; } 17.1% { transform: translateX(-27px); animation-timing-function: linear; } 27.1% { transform: translateX(-40px); animation-timing-function: ease-out; } 32.1% { transform: translateX(-45px); animation-timing-function: ease-in; } 39.6% { transform: translateX(-23px); animation-timing-function: linear; } 52.1% { transform: translateX(4px); animation-timing-function: linear; } 67.1% { transform: translateX(23px); animation-timing-function: linear; } 77.1% { transform: translateX(34px); animation-timing-function: ease-out; } 82.1% { transform: translateX(39px); animation-timing-function: ease-in; } 89.6% { transform: translateX(19px); animation-timing-function: linear; } 100% { transform: translateX(0); } }
  .grade.zero .gfish.swim::after { animation: xswim 8s infinite; }
