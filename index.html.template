<!DOCTYPE html>
<html lang="zh" translate="no">
<head>
<meta name="google" content="notranslate">
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>安全日志</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #f6f3ee;
    --surface: #fffdf8;
    --text: #221e1a;
    --muted: #6e665b;
    --border: #e1dacd;
    --th-bg: #ece5d5;
    --th-text: #221e1a;
    --zebra: #f3efe7;
    --hl: #f1ebdf;
    --ok-bg: #e6f4ea;
    --ok-border: #34a853;
    --ok-text: #14532d;
    --bad-bg: #fdecea;
    --bad-border: #d93025;
    --bad-text: #7a1c14;
    --done-bg: #fdf3d7;
    --done-border: #c9930a;
    --done-text: #6e5200;
    --warn-bg: #faf3d7;
    --warn-text: #7a5c00;
    --bar: rgba(91, 123, 165, 0.5);
    --accent: #5b7ba5;
    --accent-ink: #ffffff;
    --accent-tint: rgba(91, 123, 165, 0.13);
    --glass: rgba(255, 253, 248, 0.88);
    --accent-tint2: rgba(91, 123, 165, 0.24);
    --accent-line: rgba(91, 123, 165, 0.5);
    --ga: #34a853; --gb: #f2c018; --gc: #cf1f14; --gd: #191919;
    --ga-t: rgba(52, 168, 83, 0.12); --gb-t: rgba(242, 192, 24, 0.15);
    --gc-t: rgba(207, 31, 20, 0.12); --gd-t: rgba(25, 25, 25, 0.08);
    --ga-ink: #1e7a3c; --gb-ink: #93700a; --gc-ink: #b01a10; --gd-ink: #26221d;
    --seg-bg: rgba(255, 255, 255, 0.65);
    --tag-own-bg: #eee42b; --tag-own-ink: #000000;
    --tag-aga-bg: #6b74f3; --tag-aga-ink: #ffffff;
    --tag-agb-bg: #da2bee; --tag-agb-ink: #ffffff;
    --tag-bak-bg: #2be7ee; --tag-bak-ink: #000000;
    --tag-lan-bg: #2bee45; --tag-lan-ink: #000000;
    --tag-fff-bg: #ef4538; --tag-fff-ink: #ffffff;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --radius-card: 14px;
    --radius-sm: 8px;
    --radius-xs: 3px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #171410;
      --surface: #211e19;
      --text: #ede8e0;
      --muted: #a79c8e;
      --border: #474037;
      --th-bg: #2e2a23;
      --th-text: #ede8e0;
      --zebra: #27231e;
      --hl: #2a251e;
      --ok-bg: #17351f;
      --ok-border: #34a853;
      --ok-text: #a3d9b1;
      --bad-bg: #3f2320;
      --bad-border: #d93025;
      --bad-text: #f2b8b0;
      --done-bg: #3a3010;
      --done-border: #c9930a;
      --done-text: #f2d38a;
      --warn-bg: #3d3417;
      --warn-text: #f2c018;
      --bar: rgba(125, 153, 189, 0.5);
      --accent: #7d99bd;
      --accent-ink: #ffffff;
      --accent-tint: rgba(125, 153, 189, 0.18);
      --glass: rgba(33, 30, 25, 0.88);
      --accent-tint2: rgba(125, 153, 189, 0.30);
      --accent-line: rgba(125, 153, 189, 0.55);
      --ga: #34a853; --gb: #f2c018; --gc: #d92b1f; --gd: #141414;
      --ga-t: rgba(52, 168, 83, 0.18); --gb-t: rgba(242, 192, 24, 0.20);
      --gc-t: rgba(217, 43, 31, 0.20); --gd-t: rgba(201, 194, 180, 0.08);
      --ga-ink: #34a853; --gb-ink: #f2c018; --gc-ink: #e8705f; --gd-ink: #c9c2b4;
      --seg-bg: rgba(255, 255, 255, 0.07);
      --tag-own-bg: #6f6a09; --tag-own-ink: #ffffff;
      --tag-aga-bg: #0b148e; --tag-aga-ink: #ffffff;
      --tag-agb-bg: #810b8e; --tag-agb-ink: #ffffff;
      --tag-bak-bg: #0a7275; --tag-bak-ink: #ffffff;
      --tag-lan-bg: #0a7718; --tag-lan-ink: #ffffff;
      --tag-fff-bg: #8e140b; --tag-fff-ink: #ffffff;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 32px 24px 56px;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 16px;
    line-height: 1.55;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  /* Non-clickable parts of the board (text, numbers, images) are not
     selectable; clickable controls keep the default behaviour. */
  button, summary, .gbar, .gfish {
    -webkit-user-select: text;
    user-select: text;
  }
  .wrap { max-width: 1120px; margin: 0 auto; }
  .page-footer { text-align: center; color: var(--muted); font-size: 12px; padding: 28px 0 4px; }
  /* Page header lockup: shield disc + title + subtitle, one unit with the tab bar */
  .phead { display: flex; align-items: center; gap: 12px; margin: 0 0 24px; }
  .pdisc {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--accent-tint);
    color: var(--accent);
    display: inline-flex; align-items: center; justify-content: center;
    flex: none;
  }
  .pdisc .ic { width: 20px; height: 20px; vertical-align: 0; }
  .ptxt { flex: 1; min-width: 0; }
  h1 { font-size: 21px; font-weight: 600; line-height: 1.25; margin: 0; letter-spacing: .01em; color: var(--text); }
  /* Tier 4: window range / generated-at line */
  .sub { color: var(--muted); font-size: 12px; line-height: 1.8; margin: 4px 0 0; min-height: 3.6em; }
  .ic {
    width: 16px; height: 16px; flex: none;
    fill: none; stroke: currentColor; stroke-width: 1.8;
    stroke-linecap: round; stroke-linejoin: round;
    vertical-align: -3px;
  }
  /* Tier 0 is the grade card (see .grade below); there is no separate banner. */
  /* Tier 1: KPI strip */
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px 12px;
    margin: 16px 0 24px;
  }
  .kpi {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    grid-template-areas: "disc num" "disc lab";
    align-items: center;
    column-gap: 12px;
    padding: 16px;
  }
  .kdisc {
    grid-area: disc;
    align-self: center;
    width: 38px; height: 38px;
    border-radius: 50%;
    background: var(--accent-tint);
    color: var(--accent);
    display: flex; align-items: center; justify-content: center;
  }
  .kdisc .ic { width: 20px; height: 20px; vertical-align: 0; }
  .kdisc.danger { background: var(--bad-bg); }
    :is(.kdisc,.hdot.web-status).danger { color: var(--bad-text); }
  .kdisc.warn { background: var(--warn-bg); }
    :is(.kdisc,.hdot.web-status).warn { color: var(--warn-text); }
    :is(.kdisc,.hdot.web-status).ok { color: var(--ok-text); }
  .kpi .kn {
    grid-area: num;
    font-size: 29px; font-weight: 600; line-height: 1.12;
    font-variant-numeric: tabular-nums; color: var(--text);
  }
  .kpi .kn.danger { color: var(--bad-text); }
  .kpi .kl { grid-area: lab; color: var(--muted); font-size: 12px; margin-top: 4px; }
  .kpi .kl .kd { color: var(--bad-text); font-weight: 700; }
  /* Tier 2: section titles with icon disc */
  .t2 {
    display: flex; align-items: center; gap: 8px;
    font-size: 16px; font-weight: 600;
    margin: 0 0 12px;
  }
  .tdisc {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--accent-tint);
    color: var(--accent);
    display: inline-flex; align-items: center; justify-content: center;
    flex: none;
  }
  .tdisc .ic { width: 16px; height: 16px; vertical-align: 0; }
  .incidents { margin-bottom: 24px; }
  .incident {
    border-top: 1px solid var(--border);
    padding: 16px 4px 12px;
    margin-bottom: 12px;
  }
  .incident:first-child { border-top: 0; padding-top: 2px; }
  .incident .head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 8px; }
  .incident .title { font-weight: 600; font-size: 16px; }
  .badge {
    font-size: 13px;
    font-weight: 700;
    border: 1px solid;
    border-radius: 999px;
    padding: 2px 8px;
    white-space: nowrap;
  }
  .badge.ok  { background: var(--ok-bg);  border-color: var(--ok-border);  color: var(--ok-text); }
  .badge.warn { background: var(--bad-bg); border-color: var(--bad-border); color: var(--bad-text); }
  .badge.done { background: var(--done-bg); border-color: var(--done-border); color: var(--done-text); }
  .incident dl { margin: 0; font-size: 14px; line-height: 1.6; }
  .incident .row { display: flex; gap: 8px; margin: 8px 0; }
  .incident dt { flex: 0 0 92px; color: var(--accent); font-size: 13px; padding-top: 2px; white-space: nowrap; }
  .incident dd { margin: 0; flex: 1; min-width: 0; }
  .incident .duel { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
  .incident .resolved { margin-top: 10px; font-size: 13px; color: var(--done-text); }
  .incident .bub { position: relative; max-width: min(88%, 29rem); padding: 10px 14px; border-radius: 18px; font-size: 14px; line-height: 1.6; }
  .incident .bub.atk { --bubble-bg: #e9e4db; align-self: flex-start; background: var(--bubble-bg); border-bottom-left-radius: 0; }
  .incident .bub.def { --bubble-bg: #f4bdd4; align-self: flex-end; background: var(--bubble-bg); color: var(--text); border-bottom-right-radius: 0; max-width: min(88%, 30rem); }
  /* Borderless Telegram-style tails: the SVG baseline meets the bubble
     bottom exactly, with a 1px fill overlap across the side seam. */
  .incident .btail { position: absolute; bottom: 0; width: 10px; height: 18px; display: block; overflow: visible; pointer-events: none; }
  .incident .bub.atk .btail { left: -9px; }
  .incident .bub.def .btail { right: -9px; }
  .incident .btail .corner { fill: var(--bubble-bg); }
  @media (prefers-color-scheme: dark) {
    .incident .bub.atk { --bubble-bg: #222b36; }
    .incident .bub.def { --bubble-bg: #8b3f62; color: #ffffff; }
  }
  .incident .tgrid { display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 16px; row-gap: 4px; }
  @media (min-width: 720px) { .incident .tgrid { grid-template-columns: repeat(4, 1fr); } }
  .incident .tcell { display: flex; align-items: baseline; gap: 6px; min-width: 0; }
  .incident .tgrid i { font-style: normal; color: var(--muted); font-size: 12px; flex: none; }
  .incident .tgrid .tv { font-variant-numeric: tabular-nums; }
  .incident .srcgrid { display: grid; grid-template-columns: minmax(15ch, 1.2fr) minmax(0, 1fr); column-gap: 8px; row-gap: 3px; align-items: center; }
  .incident .source-location { display: flex; align-items: center; gap: 6px; min-width: 0; }
  .incident .sip { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
  .incident .srcnote { color: var(--muted); font-size: 13px; margin-top: 4px; }
  @media (max-width: 640px) {
    .incident .row { flex-direction: column; gap: 4px; margin: 8px 0; }
    .incident dt { flex: none; padding-top: 0; }
  }
  /* Tier 4: generator note */
  .note {
    border-left: 3px solid var(--border);
    padding: 8px 0 8px 12px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .sitestats {
    padding: 0 4px;
    margin-bottom: 24px;
  }
  /* Colophon in the emptied ranking slot (zero state): icon source and
     swimming-curve references in the nightsky (example.com) citation
     format, typeset like the statistics-period line. */
  .xrefs { font-size: 12px; line-height: 1.8; color: var(--muted); margin: 0 0 24px; word-break: break-word; }
  .xrefs .xh { margin: 14px 0 2px; font-weight: 700; }
  .xrefs .xh:first-child { margin-top: 0; }
  .xrefs p { margin: 0 0 6px; }
  .ss-row { display: grid; grid-template-columns: max-content minmax(24px, 1fr) max-content; align-items: center; gap: 12px; padding: 8px 0; font-size: 14px; }
  .ss-site {
    font-family: var(--mono);
    font-size: 14px;
    white-space: nowrap;
  }
  .ss-track {
    height: 10px;
    background: var(--zebra);
    border-radius: 999px;
    overflow: hidden;
  }
  .ss-bar { display: block; height: 100%; background: var(--bar); border-radius: 999px; }
  .ss-count {
    text-align: right;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  /* Shared chart axis: the stats block is one grid and each row is a
     subgrid of it, so the label column is sized ONCE by the longest
     label in the group -- every bar starts on the same left edge and
     every count on the same right edge. Browsers without subgrid
     keep the per-row grid above (labels fit, bars may offset). */
  @supports (grid-template-columns: subgrid) {
    .sitestats {
      display: grid;
      grid-template-columns: max-content minmax(24px, 1fr) max-content;
      column-gap: 12px;
    }
    .sitestats .t2 { grid-column: 1 / -1; }
    .ss-row { grid-template-columns: subgrid; grid-column: 1 / -1; }
  }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; min-width: 720px; font-size: 14px; line-height: 1.55; }
  thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--th-bg);
    color: var(--th-text);
    text-align: left;
    padding: 12px;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
  }
  tbody td { padding: 12px; border-top: 1px solid var(--border); vertical-align: top; }
  tbody tr:nth-child(even) { background: var(--zebra); }
  td.rank, td.count { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .medal-img { width:20px; height:auto; vertical-align:-11px; margin-right:5px; }
  th.count { text-align: right; }
  td.count { font-weight: 700; }
  .mono { font-family: var(--mono); font-size: 14px; word-break: break-all; }
  .paths { font-family: var(--mono); font-size: 14px; word-break: break-all; }
  .aban-rows { font-size: 14px; line-height: 1.7; }
  .aban-rows > div { display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 0; padding: 8px 0; border-bottom: 1px solid var(--border); }
  .aban-rows > div:last-child { border-bottom: 0; }
  .aban-rows .mono { min-width: 0; word-break: break-all; }
  .aban-rows .more { margin-left: auto; text-align: right; color: var(--muted); opacity: .65; }
  .paths div, .sites div { margin: 4px 0; }
  .more { color: var(--muted); }
  .empty { color: var(--muted); font-size: 14px; line-height: 1.6; padding: 12px 4px; }
  .acards { display: none; }
  .acard {
    border-top: 1px solid var(--border);
    padding: 16px;
    margin-bottom: 8px;
  }
  .acard:first-child { border-top: 0; }
  .acard-head { display: flex; align-items: baseline; gap: 8px; }
  .acard-top.has-medal { display: grid; grid-template-columns: 24px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 10px; align-items: center; }
  .acard-top.has-medal .medal-img { grid-row: 1 / span 2; margin-right: 0; vertical-align: middle; }
  .acard-top.has-medal .acard-head { grid-column: 2; grid-row: 1; }
  .acard-top.has-medal .acard-loc { grid-column: 2; grid-row: 2; margin: 2px 0 0; }
  .acard-rank { font-weight: 700; color: var(--muted); }
  .acard-ip { flex: 1; min-width: 0; }
  .acard-count { font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .acard-loc { color: var(--muted); font-size: 12px; margin: 4px 0 8px; }
  .acard-row { display: flex; align-items: baseline; gap: 8px; margin: 8px 0; font-size: 14px; line-height: 1.55; }
  .acard-row .sites div:first-child { margin-top: 0; }
  .acard-k { flex: 0 0 76px; color: var(--muted); font-size: 13px; white-space: nowrap; }
  .acard-v { flex: 1; min-width: 0; }
  .acard-det {
    margin-top: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 0 12px;
  }
  .acard-det summary {
    color: var(--muted); font-size: 13px; cursor: pointer;
    padding: 12px 0; min-height: 48px;
    display: flex; align-items: center; gap: 8px;
    border-radius: var(--radius-sm);
  }
  .acard-det .paths { margin: 8px 0 12px; }
  /* Incident source IPs: dropdown like the mobile 主要攻击地址 card */
  .src-det { margin-top: 4px; }
  .src-det summary {
    color: var(--muted); font-size: 13px; cursor: pointer;
    padding: 8px 0; min-height: 44px;
    display: flex; align-items: center; gap: 8px;
    border-radius: var(--radius-sm);
  }
  .src-det .srcgrid { margin: 8px 0 4px; }
  /* Big view tabs: frosted glass sticky bar */
  .vtabs {
    display: flex;
    gap: 8px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(12px) saturate(1.3);
    backdrop-filter: blur(12px) saturate(1.3);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 4px;
    margin-bottom: 24px;
    position: sticky;
    top: 0;
    z-index: 5;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .07);
  }
  .vtabs button {
    flex: 1;
    min-height: 48px;
    padding: 12px;
    font-size: 17px;
    font-weight: 600;
    font-family: inherit;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .vtabs button .ic { width: 18px; height: 18px; vertical-align: 0; }
  .vtabs button.on {
    background: var(--accent-tint);
    color: var(--accent);
    font-weight: 700;
    border-color: var(--accent-line);
  }
  .vtabs button:active { background: var(--accent-tint2); }
  /* Host accordion */
  .hacc {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    margin-bottom: 16px;
    overflow: hidden;
  }
  .hacc > summary {
    cursor: pointer; padding: 16px; min-height: 48px;
    display: flex; align-items: center; gap: 8px;
  }
  .hacc[open] > summary { background: var(--accent-tint); }
  /* Affordance signifiers: one chevron system for every expandable row */
  .hacc > summary, .hdet summary, .acard-det summary, .aban-det summary, .src-det summary { list-style: none; }
  .hacc > summary::-webkit-details-marker,
  .hdet summary::-webkit-details-marker,
  .acard-det summary::-webkit-details-marker,
  .aban-det summary::-webkit-details-marker,
  .src-det summary::-webkit-details-marker { display: none; }
  .chev {
    margin-left: auto; flex: none;
    width: 24px; height: 24px;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--accent);
    transition: transform .18s ease;
  }
  .chev .ic { width: 16px; height: 16px; vertical-align: 0; }
  details[open] > summary .chev { transform: rotate(180deg); }
  .hacc-head { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; flex: 1; min-width: 0; }
  .hdisc {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--accent-tint);
    color: var(--accent);
    display: inline-flex; align-items: center; justify-content: center;
    flex: none;
  }
  .hacc[open] .hdisc { background: var(--surface); }
  .hdisc .ic { width: 16px; height: 16px; vertical-align: 0; }
  .hacc-name { font-size: 16px; font-weight: 600; }
  .hacc[open] .hacc-name { color: var(--accent); }
  .hdot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok-border); flex: none; }
  .hdot.bad { background: var(--bad-border); }
  .hdot.warn { background: #d9a514; }
  .hdot.web-status { background: currentColor; }
    .hdot.stale { background: var(--muted); opacity: .45; }
  .hacc-sum { color: var(--muted); font-size: 13px; }
  @media (max-width: 719px) {
    .hacc-sum { flex-basis: 100%; padding-left: 40px; }
  }
  .hstale { color: var(--muted); font-size: 12px; }
  .hacc-body { padding: 16px; border-top: 1px solid var(--border); font-size: 14px; line-height: 1.6; }
  .hrow { display: flex; gap: 8px; margin: 8px 0; }
  .hrow .hk {
    flex: 0 0 108px; color: var(--muted); font-size: 13px;
    padding-top: 3px; white-space: nowrap;
    display: flex; align-items: center; gap: 8px;
  }
  .hrow .hk .ic { width: 16px; height: 16px; vertical-align: 0; }
  .hrow .hv { flex: 1; min-width: 0; }
  .hip { display: flex; align-items: center; column-gap: 6px; margin: 4px 0; }
  .hip > .more { min-width: 0; }
  .hip .mono, .hip .who, .hip .anom, .hip .unk, .hip .okb, .hip .mchip { flex: none; }
  .hip .who { margin-left: auto; }
  /* Tier 4: per-host window / generated-at */
