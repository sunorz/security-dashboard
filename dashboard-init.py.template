import smtplib
import imaplib
import time
from datetime import datetime
from email.mime.text import MIMEText
# SMTP Email Configuration
SMTP_SERVER = "__SMTP_HOST__"
SMTP_PORT = 465
SENDER_EMAIL = "__SMTP_SENDER__"
SENDER_PASSWORD = "__SMTP_PASSWORD__"
RECEIVER_EMAIL = "__SMTP_RECEIVER__"

# IMAP Email Configuration (用于把已发送邮件存入"已发送"文件夹)
IMAP_SERVER = "imap.sohu.com"
IMAP_PORT = 993
IMAP_SENT_FOLDER = "&XfJT0ZABkK5O9g-"  # 搜狐邮箱"已发送"文件夹的实际IMAP名称（UTF-7编码）


def save_to_sent(msg):
    try:
        imap = imaplib.IMAP4_SSL(IMAP_SERVER, IMAP_PORT)
        imap.login(SENDER_EMAIL, SENDER_PASSWORD)
        imap.append(
            IMAP_SENT_FOLDER,
            "",
            imaplib.Time2Internaldate(time.time()),
            msg.as_bytes(),
        )
        imap.logout()
        print("Email saved to Sent folder successfully.")
    except Exception as e:
        print(f"Failed to save to Sent folder: {type(e).__name__}: {e}")


def send_email(subject, body, max_retries=3, retry_delay=30):
    """
    发送邮件，失败时自动重试。
    max_retries: 最大重试次数（不含首次尝试）
    retry_delay: 每次重试之间的基础等待秒数（会随重试次数递增：30s, 60s, 90s...）
    """
    msg = MIMEText(body, "html", "utf-8")
    msg["Subject"] = subject
    msg["From"] = SENDER_EMAIL
    msg["To"] = RECEIVER_EMAIL

    last_error = None

    for attempt in range(1, max_retries + 2):  # 1 = 首次尝试，之后是重试
        try:
            # 465 是隐式 SSL 端口，连接建立时就已经是加密的，
            # 必须用 SMTP_SSL，不能用 SMTP() + starttls()（那是给 587 用的）。
            with smtplib.SMTP_SSL(SMTP_SERVER, SMTP_PORT, timeout=15) as server:
                server.login(SENDER_EMAIL, SENDER_PASSWORD)
                server.sendmail(SENDER_EMAIL, [RECEIVER_EMAIL], msg.as_string())
                print(f"Status report email sent successfully. (attempt {attempt})")
            save_to_sent(msg)
            return  # 成功，直接返回，不再重试
        except smtplib.SMTPAuthenticationError as e:
            # 认证失败重试也没用，直接记录并退出，避免账号被进一步风控/锁定
            print(f"[AUTH FAILED] 用户名或独立密码不对，或者独立密码已过期/被重置: {e}")
            return
        except smtplib.SMTPConnectError as e:
            last_error = e
            print(f"[CONNECT FAILED] 连不上服务器 (attempt {attempt}/{max_retries + 1}): {e}")
        except (TimeoutError, smtplib.SMTPServerDisconnected) as e:
            last_error = e
            print(f"[TIMEOUT/DISCONNECTED] 连接被中断，可能是偶发风控或网络抖动 (attempt {attempt}/{max_retries + 1}): {type(e).__name__}: {e}")
        except Exception as e:
            last_error = e
            print(f"Failed to send email (attempt {attempt}/{max_retries + 1}): {type(e).__name__}: {e}")

        if attempt <= max_retries:
            wait_time = retry_delay * attempt  # 30s, 60s, 90s 递增，避免连续撞上同一个限流窗口
            print(f"Retrying in {wait_time} seconds...")
            time.sleep(wait_time)

    print(f"[GIVE UP] 已重试 {max_retries} 次仍然失败，放弃发送。最后一次错误: {last_error}")


def daily_report():
    """Daily security report: rotate the dashboard key, generate the
    dashboard data, and send the email with the dashboard link.

    No website connectivity check (that is a separate function); the
    dashboard does two things only: generate the board, and send its link.
    """
    today_str = datetime.now().strftime("%Y-%m-%d")
    subject = f"[{today_str}] 安全日报"
    # Rotate the dashboard key first and confirm it took effect, then
    # generate the data and send the email; if rotation fails the email
    # still goes out, but the footer link is replaced with a failure note.
    _key_rotated = True
    try:
        rotate_dashboard_key_verified()
    except Exception as e:
        _key_rotated = False
        print(f"Dashboard key rotation failed: {type(e).__name__}: {e}")
    # Generate the security dashboard data; a failure does not stop the email
    try:
        write_security_data()
    except Exception as e:
        print(f"Failed to write security data: {type(e).__name__}: {e}")
    if _key_rotated:
        email_body = f"\n<p>Security log: https://shop.example.com/dashboard/?key={dashboard_report_path().stem[2:]}</p>"
    else:
        email_body = "\n<p>key更新失败，请检查设置。</p>"
    # Sync the dashboard link to the relay file (host 2 reads it and writes
    # it to the end of its file)
    _write_dashboard_link_relay()
    if _LAST_AUTOBANS_NEW:
        _ab_line = ", ".join(
            "%s (%d attack requests in 7 days)" % (b["ip"], b["count"])
            for b in _LAST_AUTOBANS_NEW)
        email_body += f"\n<p>Auto-banned this run: {_ab_line}</p>"
    send_email(subject, email_body)


