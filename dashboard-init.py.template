def _secure_line_ts(line, now):
    m = _SECURE_TS_RE.match(line)
    if not m:
        return None
    mon, day, hh, mm, ss = m.groups()
    if mon not in _MONTH_NUM:
        return None
    try:
        ts = datetime(now.year, _MONTH_NUM[mon], int(day),
                      int(hh), int(mm), int(ss))
    except ValueError:
        return None
    if ts > now + timedelta(days=1):
        ts = ts.replace(year=now.year - 1)
    return ts


def _iter_secure_lines():
    paths = ["/var/log/secure"]
    try:
        for name in sorted(os.listdir("/var/log")):
            if name.startswith("secure-") or name.startswith("secure."):
                paths.append(os.path.join("/var/log", name))
    except Exception:
        pass
    for path in paths:
        try:
            if path.endswith(".gz"):
                fh = gzip.open(path, "rt", encoding="utf-8", errors="ignore")
            else:
                fh = open(path, "r", encoding="utf-8", errors="ignore")
        except Exception:
            continue
        with fh:
            for line in fh:
                yield line



