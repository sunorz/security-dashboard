def _classify_signature(method, target, site):
    """把一条攻击请求按手法分类，返回 (签名, 标题, 想干什么)。
    只依据请求本身的特征判断；认不出的走兜底说明，不编造漏洞名。"""
    import urllib.parse
    raw = target or ""
    try:
        dec = urllib.parse.unquote(raw)
    except Exception:
        dec = raw
    hay = (raw + "\n" + dec).lower()
    if "{pboot" in hay or "pboot:" in hay:
        return ("pbootcms", "PbootCMS 模板注入攻击",
                "他想利用 PbootCMS 模板注入漏洞，把代码藏进网址让服务器当模板执行，"
                "再写入木马文件、夺取控制权。")
    if ("allow_url_include" in hay or "auto_prepend_file" in hay
            or ("%ad" in raw.lower() and ".php" in hay)):
        return ("phpcgi_rce", "PHP-CGI 漏洞利用（CVE-2024-4577）",
                "他想利用 PHP 的已知漏洞（CVE-2024-4577），在网址参数里夹带特殊编码，"
                "骗服务器把参数当成 PHP 配置执行，从而远程运行命令。")
    if "../" in dec or "..\\" in dec or "..;" in hay:
        return ("traversal", "路径遍历",
                "他在网址里塞入 ../ 这类跳转符号，想跳出网站目录，"
                "去读服务器上本不该对外开放的其他文件（比如系统配置、密码文件）。")
    if re.match(r"^/(categories|tags)/", dec):
        return ("site_content", "本站内容页（疑似误报）",
                "请求的是博客自己的分类/标签页面，只因页面名称里含有 wordpress 等关键词，"
                "被攻击特征规则误报；这与普通读者打开这个页面没有区别。")
    if (".env" in hay or ".git" in hay or ".aws" in hay or "/.config" in hay
            or ".bak" in hay or ".sql" in hay or "/backup" in hay):
        return ("config_theft", "窃取配置文件或源码",
                "他想偷网站的配置文件或源码仓库（如 .env、.git），"
                "这类文件里可能存着数据库密码、密钥等敏感信息，拿到手就能进一步入侵。")
    if (".zip" in hay or ".tar" in hay or ".tgz" in hay or ".rar" in hay
            or ".7z" in hay or ".gz" in hay or ".bz2" in hay or ".xz" in hay):
        return ("backup_theft", "窃取网站备份",
                "他想下载网站的备份压缩包（如 wordpress.zip、backup.tar.gz），"
                "这类压缩包里通常装着整站源码和数据库配置文件（如 wp-config.php），"
                "拿到手就等于拿到了数据库密码和整站源码。")
    if ("wp-login" in hay or "wp-admin" in hay or "wp-content" in hay
            or "wp-includes" in hay or "wp-json" in hay or "xmlrpc" in hay
            or "wp-" in hay):
        return ("wordpress", "WordPress 探测",
                "他在找 WordPress 的登录入口和已知漏洞，想确认这台服务器是不是用 WordPress 建的站；"
                "本站不是 WordPress，这些入口并不存在。")
    if ("_debugbar" in hay or "telescope" in hay or "actuator" in hay
            or "graphql" in hay or "_profiler" in hay or "app_dev.php" in hay
            or "phpinfo" in hay):
        return ("debug_interface", "寻找调试/管理接口",
                "他在找网站框架自带的调试或管理接口（如开发调试条、性能分析页）；"
                "这类接口若对外开放，可能泄露网站内部信息，甚至被用来执行命令。")
    if "cgi-bin" in hay:
        return ("cgi_probe", "CGI 程序漏洞探测",
                "他在试老式 CGI 程序的已知漏洞路径，想借此在服务器上执行命令或读取文件。")
    if ".php" in hay:
        return ("webshell", "试探木马文件",
                "他在逐个试常见的木马/后门文件名（如各种 .php 文件），"
                "想看看服务器上有没有现成的后门可以利用；本站没有这类文件。")
    shown = dec if len(dec) <= 90 else dec[:90] + "…"
    return ("other", "未识别的探测",
            "他对 %s 的 %s 发起了 %s 请求进行探测。特征库里没有与之匹配的已知攻击手法，"
            "无法确定他的具体目的，但可以肯定这不是正常浏览。" % (site, shown, method))


def _interpret_incident(sig, cands, home_size, landed404):
    """根据一组同类候选请求的实际响应，生成（结果如何，结论）。
    结论只用「未得手 / 需留意」两种，依据写进结果说明里。
    每种结果有 2~3 条风趣又有知识点的文案，随机挑一条。"""
    import random
    if sig == "site_content":
        return (random.choice([
            "他命中的只是本站公开页面，内容本来就是公开的。路径里带了 wordpress 这个词，"
            "被规则误当成攻击了。",
            "他撞上的只是本站公开页面，内容人人都能看。路径里有个 wordpress 关键词，"
            "规则一激动就误报了。",
            "他打开的只是博客自己的分类页，内容本来就是公开的。名字里带了 wordpress，"
            "被攻击特征规则错认了。",
        ]), "未得手")
    statuses = [c["status"] for c in cands]
    uniq = set(statuses)
    if uniq == {"200"}:
        if home_size is not None and all(c["size"] == home_size for c in cands):
            return (random.choice([
                "他只拿到了公开首页（%d 字节，和首页一模一样），注入代码根本没起作用。"
                "网址里的代码只是串字符，服务器可不会把它当真。",
                "他费了半天劲，只拿到了人人都能看的公开首页（%d 字节）。注入的代码一句也没执行，"
                "纯属白忙活。",
                "他拿到的就是公开首页（%d 字节，分毫不差），注入代码连个响都没听见。"
                "网址参数只是字符串，可不是能执行的命令。",
            ]) % home_size, "未得手")
        return (random.choice([
            "他拿到了 200 响应，但大小和首页对不上，到底拿了什么说不清。"
            "200 只代表“给了东西”，不代表“给的是好东西”。建议人工核查。",
            "他拿到了 200，但返回的大小和首页对不上，里面装了什么没人知道。"
            "200 是“成功”的意思，可没保证内容就是你想要的。建议人工核查。",
            "服务器给了他 200，可大小和首页不匹配，到底吐了什么出来说不清。"
            "200 只管“给了”，不管“给得对不对”。建议人工核查。",
        ]), "需留意")
    if uniq <= {"301", "302", "303", "307", "308"}:
        if landed404:
            return (random.choice([
                "他被重定向到 404，什么都没拿到。3xx 只是指路，"
                "路的尽头是块“此路不通”的牌子。",
                "他跟着重定向走了一圈，最后落到 404。3xx 的意思是“去别处”，"
                "可别处压根啥也没有。",
                "他被重定向带去了 404，扑了个空。重定向只是张指路牌，"
                "不保证路那头有东西。",
            ]), "未得手")
        return (random.choice([
            "服务器只给了他重定向（%s），没给文件内容。3xx 就是句“去别处”，"
            "文件可不会自己跟过去。",
            "他只拿到了一串重定向（%s），文件内容半点没见着。3xx 是让你换个地方找，"
            "可不是把文件递到你手里。",
            "服务器甩给他一个重定向（%s）就打发了，文件内容想都别想。3xx 只负责指路，"
            "不负责送货。",
        ]) % "、".join(sorted(uniq)), "未得手")
    if uniq == {"502"}:
        return (random.choice([
            "后端/隧道当时断了，他的请求根本没到网站程序。502 是网关和后端失联，"
            "请求在半路就断了线。",
            "他的请求走到一半，后端/隧道断了。502 就是网关找不到后端，"
            "请求连网站的门都没摸到。",
            "后端/隧道当时正掉线，他的请求半路夭折。502 的意思是“网关掉了链子”，"
            "后面的程序压根没收到。",
        ]), "未得手")
    if uniq == {"444"}:
        return (random.choice([
            "服务器连回应都懒得给，直接掐断了连接。444 是 nginx 的独门操作，"
            "不回话、不解释，比拉黑还干脆，他什么都没拿到。",
            "服务器一句话没说，直接把线掐了。444 是 nginx 的特色，不返回任何内容，"
            "连个状态行都省了，他扑了个空。",
            "他连个回应都没等到，连接直接被掐断。444 根本不是标准状态码，"
            "是 nginx 自创的“已读不回”，干脆利落。",
        ]), "未得手")
    if uniq <= {"400", "401", "403", "405", "411", "414", "429"}:
        return (random.choice([
            "服务器用 %s 把他挡了回去，他什么都没拿到。4xx 的意思是“你的请求有问题”，"
            "服务器直接拒收。",
            "他递过去的请求有问题，服务器用 %s 直接拒收。4xx 就是客户端的错，"
            "怪不得服务器不搭理他。",
            "服务器甩了他一个 %s，头都不回。4xx 代表请求本身不合格，服务器懒得伺候。",
        ]) % "、".join(sorted(uniq)), "未得手")
    if uniq == {"500"}:
        return (random.choice([
            "服务器报了 500 内部错误，他什么都没拿到。500 是服务器自己出了岔子，"
            "他连门都没摸到。",
            "服务器自己先报了 500 内部错误，他什么都没捞着。500 的意思是“服务器内部翻车了”，"
            "跟他没关系，纯属他运气差。",
            "他还没动手，服务器自己就 500 了。内部错误一出，请求直接作废，"
            "他连门都没摸到。",
        ]), "未得手")
    home200 = 0
    unknown200 = 0
    for c in cands:
        if c["status"] == "200":
            if home_size is not None and c["size"] == home_size:
                home200 += 1
            else:
                unknown200 += 1
    parts = []
    if home200:
        parts.append("%d 次只拿到公开首页" % home200)
    if unknown200:
        parts.append("%d 次拿到 200 但内容说不清" % unknown200)
    redir = sum(1 for s in statuses if s in ("301", "302", "303", "307", "308"))
    if redir:
        parts.append("%d 次被重定向" % redir + ("到 404" if landed404 else ""))
    n502 = statuses.count("502")
    if n502:
        parts.append("%d 次碰上 502" % n502)
    rest = len(cands) - home200 - unknown200 - redir - n502
    if rest > 0:
        parts.append("%d 次被挡了回去" % rest)
    verdict = "需留意" if unknown200 else "未得手"
    if unknown200:
        return ("他 " + "，".join(parts) + "。" + random.choice([
            "建议人工核查。",
            "这事得人工看一眼。",
            "建议人工核查一下。",
        ]), verdict)
    return ("他 " + "，".join(parts) + "。" + random.choice([
        "总之，他这一趟白跑了。",
        "总之，他这一趟啥也没捞着。",
        "这一趟下来，他还是空手而归。",
    ]), verdict)


def _describe_source(cands, iloc):
    cf_ips = {c["ip"] for c in cands if c["via_cf"]}
    real_ips = sorted({c["ip"] for c in cands if not c["via_cf"]})
    parts = []
    if real_ips:
        shown = []
        for ip in real_ips[:3]:
            loc = iloc.get(ip)
            shown.append("%s（%s）" % (ip, loc) if loc else ip)
        s = "真实 IP：" + "、".join(shown)
        if len(real_ips) > 3:
            s += " 等共 %d 个" % len(real_ips)
        parts.append(s)
    if cf_ips:
        parts.append("经 Cloudflare 节点转发（%d 个节点 IP，看不到真实来源）" % len(cf_ips))
    return "；".join(parts) if parts else "来源未知"


def _source_list(cands, iloc):
    """事件来源的结构化清单（供看板格式化排版）：全部真实 IP（带归属地）、
    真实 IP 总数、经 Cloudflare 转发的节点 IP 数。看板以下拉菜单全量展示。"""
    real_ips = sorted({c["ip"] for c in cands if not c["via_cf"]})
    cf_count = len({c["ip"] for c in cands if c["via_cf"]})
    sources = []
    for ip in real_ips:
        entry = {"ip": ip}
        loc = iloc.get(ip)
        if loc:
            entry["loc"] = loc
        sources.append(entry)
    return sources, len(real_ips), cf_count


def _fmt_range(first, last):
    if first.date() == last.date():
        return "%s ~ %s" % (first.strftime("%Y-%m-%d %H:%M:%S"),
                             last.strftime("%H:%M:%S"))
    return "%s ~ %s" % (first.strftime("%Y-%m-%d %H:%M:%S"),
                         last.strftime("%Y-%m-%d %H:%M:%S"))


def _landed_404(follow_index, cand):
    for ts2, st2 in follow_index.get(cand["target"], []):
        if st2 == "404" and 0 <= (ts2 - cand["ts"]).total_seconds() <= 180:
            return True
    return False


def _build_incidents(candidates, home_sizes, follow_index):
    """把非 404/403 的探测请求按（手法签名 + 站点）分组成事件，
    每组生成一段主人能看懂的说明，原始日志只保留一条作样本。"""
    groups = {}
    for c in candidates:
        sig, title, intent = _classify_signature(c["method"], c["target"], c["site"])
        key = (sig, c["site"])
        g = groups.get(key)
        if g is None:
            g = groups[key] = {
                "signature": sig, "title": title, "intent": intent,
                "site": c["site"], "cands": [],
            }
        g["cands"].append(c)
    real_ips = sorted({c["ip"] for g in groups.values()
                       for c in g["cands"] if not c["via_cf"]})
    iloc = _geolocate(real_ips) if real_ips else {}
    incidents = []
    for g in groups.values():
        cands = sorted(g["cands"], key=lambda c: c["ts"])
        home_size = None
        if home_sizes.get(g["site"]):
            top_size = home_sizes[g["site"]].most_common(1)[0][0]
            try:
                home_size = int(top_size)
            except (TypeError, ValueError):
                home_size = None
        landed404 = any(
            _landed_404(follow_index, c) for c in cands
            if c["status"] in ("301", "302", "303", "307", "308")
        )
        outcome, verdict = _interpret_incident(
            g["signature"], cands, home_size, landed404)
        src_list, src_total, cf_nodes = _source_list(cands, iloc)
        incidents.append({
            "signature": g["signature"],
            "title": g["title"],
            "site": g["site"],
            "count": len(cands),
            "first_seen": cands[0]["ts"].strftime("%Y-%m-%d %H:%M:%S"),
            "last_seen": cands[-1]["ts"].strftime("%Y-%m-%d %H:%M:%S"),
            "time_range": _fmt_range(cands[0]["ts"], cands[-1]["ts"]),
            "source": _describe_source(cands, iloc),
            "intent": g["intent"],
            "outcome": outcome,
            "verdict": verdict,
            "raw_example": cands[0]["raw"],
            "sources": src_list,
            "sources_total": src_total,
            "cf_nodes": cf_nodes,
        })
    incidents.sort(key=lambda x: (-x["count"], x["first_seen"]))
    return incidents


def _parse_log_time(raw):
    """'20/Nov/2026:07:12:33 +0800' -> naive datetime（日志时区即 CST）。"""
    try:
        parts = raw.replace(":", " ").split()
        day, mon, year = parts[0].split("/")
        return datetime(
            int(year), _MONTH_NUM[mon], int(day),
            int(parts[1]), int(parts[2]), int(parts[3]),
        )
    except Exception:
        return None


def dashboard_report_path():
    from pathlib import Path

    reports = [p for p in Path(DASHBOARD_DIR).glob("s-*.json")
               if re.fullmatch(r"s-[0-9a-f]{64}[.]json", p.name)
               and p.is_file() and not p.is_symlink()]
    if len(reports) != 1:
        raise RuntimeError("Expected exactly one active dashboard report")
    return reports[0]


def rotate_dashboard_key():
    import secrets

    current = dashboard_report_path()
    replacement = current.with_name("s-" + secrets.token_hex(32) + ".json")
    current.rename(replacement)


def rotate_dashboard_key_verified():
    """轮换看板 key 并确认已生效：返回新 key。
    轮换前后文件名必须不同且目录内仍恰好一份数据文件，否则抛异常，
    调用方据此把邮件页脚换成失败提示（邮件照发）。"""
    before = dashboard_report_path()
    rotate_dashboard_key()
    after = dashboard_report_path()
    if after == before:
        raise RuntimeError("Dashboard key rotation did not take effect")
    return after.stem[2:]


def _write_dashboard_link_relay():
    """把本封邮件里的看板地址同步写到中转文件：
    每次发邮件前调用，值与邮件页脚完全一致（轮换后的新 key）。
    另一台主机的刷新脚本每 30 分钟取一次，写进指定文件末尾。失败不影响邮件发送。"""
    try:
        key = dashboard_report_path().stem[2:]
        line = "[安全看板](https://shop.example.com/dashboard/?key=%s)\n" % key
        with open(_DASHBOARD_LINK_RELAY, "w", encoding="utf-8") as f:
            f.write(line)
        os.chmod(_DASHBOARD_LINK_RELAY, 0o644)
    except Exception as e:
        print("Dashboard link relay failed: %s: %s"
              % (type(e).__name__, e))


def _security_window():
    """统计时段（CST）：以 07:00 为界，07:30 才翻页；
    时段结束封顶于起始日 22:00，22:00 后冻结至次日 07:00。
    07:00–07:29:59 间显示上一时段的完整累计：昨日 07:00 → 今日
    07:00（即截至今日 06:59:59）。"""
    now = datetime.now()
    start = now.replace(hour=7, minute=0, second=0, microsecond=0)
    if now < start:
        start -= timedelta(days=1)
    if now < start + timedelta(minutes=30):
        return start - timedelta(days=1), start
    end = min(now, start + timedelta(hours=15))
    return start, end


_GEO_FAILED = set()


def _geolocate(ips):
    """用 ip-api.com 批量查询归属地（国家 · 城市），每批 100 个，批间停顿。"""
    locs = {}
    for i in range(0, len(ips), 100):
        chunk = ips[i:i + 100]
        try:
            req = urllib.request.Request(
                "http://ip-api.com/batch?fields=status,country,city,query",
                data=json.dumps([{"query": ip} for ip in chunk]).encode("utf-8"),
                headers={"Content-Type": "application/json"},
            )
            with urllib.request.urlopen(req, timeout=30) as resp:
                for item in json.loads(resp.read().decode("utf-8")):
                    if item.get("status") == "success":
                        loc = item.get("country") or ""
                        city = item.get("city") or ""
                        if city:
                            loc = (loc + " · " + city) if loc else city
                        if loc:
                            locs[item.get("query")] = loc
        except Exception as e:
            _GEO_FAILED.update(chunk)
            print(f"Geolocation chunk failed: {type(e).__name__}: {e}")
        if i + 100 < len(ips):
            time.sleep(2)
    return locs



