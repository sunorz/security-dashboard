def _net(s):
    """Parse a network placeholder. An unfilled/invalid value becomes
    TEST-NET-1 (192.0.2.0/24, a documentation range that never carries real
    traffic), so the program still runs and the entry simply never matches.
    Fill in a real network only if you have one; otherwise leave it."""
    try:
        return ipaddress.ip_network(s)
    except ValueError:
        return ipaddress.ip_network("192.0.2.0/24")


# 判定规则（白名单/排除项）存在 __RULES_PATH__，改规则改文件，
# 不动代码；文件坏了或丢了，用下面的内置默认值兜底，不停摆。
_RULES_PATH = "__RULES_PATH__"
# 配置文件是规则的唯一来源，不再内置默认值兜底。
# 文件丢了、不是 JSON、不是 dict、或任一节缺失/写坏，规则即不可信，
# _RULES_OK 为 False，生成器写未知看板，不参与评级；封禁按已有 7 天累计继续执行。
# 占位值仅保证模块可导入、正则可编译，绝不参与评级与封禁。
_RULES_PLACEHOLDER = {
    "good_bots": [],
    "taxonomy_regexes": [r"(?!)"],
    "blog_exact_paths": [],
    "image_extensions": [],
    "cgi_bin_regex": r"(?!)",
    "exclude_ips": [],
    "exclude_nets": [],
    "autoban_safe_nets": [],
}


def _load_rules():
    try:
        with open(_RULES_PATH, encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        print("dashboard rules: cannot load %s (%s); rules unknown" % (_RULES_PATH, e))
        return dict(_RULES_PLACEHOLDER), False
    if not isinstance(data, dict):
        print("dashboard rules: bad format in %s; rules unknown" % _RULES_PATH)
        return dict(_RULES_PLACEHOLDER), False

    def _str_list(v):
        return isinstance(v, list) and all(isinstance(x, str) and x for x in v)

    def _section(name, value_key):
        sec = data.get(name)
        if isinstance(sec, dict):
            return sec.get(value_key)
        return None

    rules = {}
    ok = True
    v = _section("good_bots", "substrings")
    if _str_list(v):
        rules["good_bots"] = v
    else:
        ok = False
    v = _section("taxonomy_regexes", "regexes")
    if _str_list(v):
        good = []
        for p in v:
            try:
                re.compile(p)
                good.append(p)
            except re.error:
                print("dashboard rules: bad taxonomy regex skipped: %r" % p)
        if good:
            rules["taxonomy_regexes"] = good
        else:
            ok = False
    else:
        ok = False
    v = _section("blog_exact_paths", "paths")
    if _str_list(v) and all(p.startswith("/") for p in v):
        rules["blog_exact_paths"] = v
    else:
        ok = False
    v = _section("image_extensions", "extensions")
    if _str_list(v) and all(re.fullmatch(r"[A-Za-z0-9]+", e) for e in v):
        rules["image_extensions"] = v
    else:
        ok = False
    v = _section("cgi_bin_regex", "regex")
    if isinstance(v, str) and v:
        try:
            re.compile(v)
            rules["cgi_bin_regex"] = v
        except re.error:
            print("dashboard rules: bad cgi-bin regex skipped")
            ok = False
    else:
        ok = False
    v = _section("exclude_ips", "ips")
    if _str_list(v):
        try:
            [ipaddress.ip_address(x) for x in v]
            rules["exclude_ips"] = v
        except ValueError:
            print("dashboard rules: bad exclude_ips skipped")
            ok = False
    else:
        ok = False
    for name, key in (("exclude_nets", "cidrs"), ("autoban_safe_nets", "cidrs")):
        v = _section(name, key)
        if _str_list(v):
            try:
                [ipaddress.ip_network(x) for x in v]
                rules[name] = v
            except ValueError:
                print("dashboard rules: bad %s skipped" % name)
                ok = False
        else:
            ok = False
    if not ok:
        print("dashboard rules: config invalid; rules unknown")
        return dict(_RULES_PLACEHOLDER), False
    return rules, True


_RULES, _RULES_OK = _load_rules()

