# --- Security grades (AQI-style, one per view/host) -----------------------
# The dashboard shows three grades: the website on its own tab, and each
# host on its own accordion section. A = quiet, nothing to do; B = routine
# noise, all blocked; C = worth a look; D = act now. The texts never
# contain account names or key fingerprints (IPs are fine).
# Tone rule (owner): A/B texts may be relaxed and conversational;
# C/D texts are serious and direct — facts first, then imperatives,
# no softeners.
_GRADE_HOST_NAMES = {"host1": "Host 1", "host2": "Host 2"}


def _grade_host_stale(entry, now):
    """Mirror of the page rule: no generated_at, unparseable, or > 26 h."""
    if not entry:
        return True
    raw = entry.get("generated_at")
    if not raw:
        return True
    try:
        gen = datetime.strptime(raw, "%Y-%m-%d %H:%M:%S")
    except (TypeError, ValueError):
        return True
    return (now - gen).total_seconds() > 26 * 3600


def _alert_total(arr):
    return sum(int(x.get("count") or 0) for x in (arr or []))


_RESOLUTIONS_PATH = "__RESOLUTIONS_PATH__"


def _load_resolutions():
    try:
        with open(_RESOLUTIONS_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, list):
            return [r for r in data if isinstance(r, dict)]
    except Exception:
        pass
    return []


def _incident_resolved(inc, resolutions):
    """需留意事件的核销判定：登记表里有同 签名+站点+发生日期 的
    记录才算已核实处理（维护者逐起核实后登记，不自动过期到次日）。"""
    sig = inc.get("signature")
    site = inc.get("site")
    day = (inc.get("first_seen") or "")[:10]
    for r in resolutions or []:
        if (r.get("signature") == sig and r.get("site") == site
                and r.get("date") == day):
            return True
    return False


def _record_resolution(signature, site, note):
    """维护者核实一起需留意事件后记录核销（--resolve-incident）。"""
    items = _load_resolutions()
    items.append({
        "date": datetime.now().strftime("%Y-%m-%d"),
        "signature": signature,
        "site": site,
        "note": note,
        "at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
    })
    tmp = _RESOLUTIONS_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(items, f, ensure_ascii=False, indent=1)
    os.rename(tmp, _RESOLUTIONS_PATH)
    print("Recorded resolution: %s @ %s" % (signature, site))


def _grade_web_unknown():
    # 规则/数据不可信时网站侧写未知（页面按 zero 渲染问号卡），不参与阶梯。
    return {"level": "A", "zero": True,
            "what": "本时段数据未知。",
            "action": "安全看板运行出现问题，请联系管理员。"}


def _grade_web(result):
    total = int(result.get("total_attack_requests") or 0)
    attackers = result.get("attackers") or []
    incidents = (result.get("breach") or {}).get("incidents") or []
    warn = [i for i in incidents if i.get("verdict") == "需留意"]
    heavy_ips = [a for a in attackers
                 if int(a.get("count") or 0) >= _AUTOBAN_THRESHOLD]
    heavy = len(heavy_ips)
    # 全零就是干净的 A，不带问号、不报警；未知另走 _grade_web_unknown。
    if total == 0 and not incidents:
        return {"level": "A",
                "what": "本时段他们还没起床。",
                "action": "别急，等着看戏。"}
    # 等级回退：需处理的问题一旦核销，等级
    # 回退到其余事实给出的等级。核销口径：达到封禁线的 IP 已进
    # nginx 黑名单（查 blocklist 实况）；需留意事件已在核销登记
    # __RESOLUTIONS_PATH__ 里按 签名+站点+日期 记录
    # （维护者核实后用 --resolve-incident 登记）。安全事件总数
    # 不参与评级（总数只说明外面有人
    # 探测，是公网常态而非风险本身）。
    denied = _blocklist_denied()
    heavy_open = sum(1 for a in heavy_ips if a.get("ip") not in denied)
    heavy_resolved = heavy - heavy_open
    _resolutions = _load_resolutions()
    warn_open = [i for i in warn
                 if not _incident_resolved(i, _resolutions)]
    warn_resolved = len(warn) - len(warn_open)
    # 网站侧评级：只看需留意与
    # 封禁线，两线取最高——需留意阶梯（本时段需留意事件
    # 总数，含已核销）：0 A、1-3 B、4-6 C、7+ D；未核销的
    # 需留意有即 D；封禁线阶梯（达到自动封禁线且尚未封禁
    # 的 IP 个数）：>5 B、>10 C、>15 D。安全事件总数不
    # 参与评级（原 >10 B、>15 C、>20 D 阶梯废除）。
    order = {"A": 0, "B": 1, "C": 2, "D": 3}

    def _by_heavy(n):
        if n > 15:
            return "D"
        if n > 10:
            return "C"
        if n > 5:
            return "B"
        return "A"

    def _by_warn(n):
        if n >= 7:
            return "D"
        if n >= 4:
            return "C"
        if n >= 1:
            return "B"
        return "A"

    pre = _by_heavy(heavy)
    if warn_open:
        pre = "D"
    elif order[_by_warn(len(warn))] > order[pre]:
        pre = _by_warn(len(warn))
    level = _by_heavy(heavy_open)
    if order[_by_warn(len(warn))] > order[level]:
        level = _by_warn(len(warn))
    if warn_open:
        return {"level": "D",
                "what": "安全事件中有 %d 起被判为需留意。" % len(warn_open),
                "action": "立即处理：打开下方事件详情，逐条核对。"}
    clauses = []
    if heavy_open > 5:
        clauses.append("%d 个 IP 达到自动封禁线" % heavy_open)
    if warn:
        clauses.append("%d 起需留意事件已核实处理" % len(warn))
    what = "；".join(clauses) + "。" if clauses else ""
    if level == "D":
        if len(warn) >= 7 and heavy_open <= 15:
            action = "无需操作。需留意事件均已核实处理，但本时段数量偏多，留意即可。"
        else:
            action = "立即处理：打开下方事件详情与攻击者排名，逐条核对。"
        grade = {"level": "D", "what": what, "action": action}
    elif level == "C":
        if len(warn) >= 4 and heavy_open <= 10:
            action = "无需操作。需留意事件均已核实处理，扫一眼即可。"
        else:
            action = "无需操作。达到封禁线的 IP 已自动封禁，扫一眼即可。"
        grade = {"level": "C", "what": what, "action": action}
    elif level == "B":
        grade = {"level": "B", "what": what,
                 "action": "无需操作。扫一眼即可。"}
    else:
        if incidents:
            what = ("%d 次探测与攻击请求，%d 起事件均未得手。"
                    % (total, len(incidents)))
        else:
            what = "%d 次探测与攻击请求，均被拦截（404/403）。" % total
        grade = {"level": "A", "what": what, "action": "无需任何操作。"}
    if (warn_resolved or heavy_resolved) and (
            order[level] < order[pre]
            or (warn_resolved and level == _by_warn(len(warn)))):
        bits = []
        if warn_resolved:
            bits.append("%d 起需留意事件已核实" % warn_resolved)
        if heavy_resolved:
            bits.append("%d 个达到封禁线的 IP 已封禁" % heavy_resolved)
        grade["done"] = True
        grade["done_text"] = "已处理：" + "；".join(bits) + "。"
    return grade


def _grade_host_impl(key, entry, now):
    if entry is None or _grade_host_stale(entry, now):
        state = "已过期" if entry else "缺失"
        if key == "host2":
            action = "先确认推送是否正常。"
        else:
            action = "先确认本机主机数据采集是否正常。"
        return {"level": "C",
                "what": "数据%s，本时段情况不明。" % state,
                "action": action}
    anomaly = int(entry.get("ssh_anomaly") or 0)
    alert = entry.get("authkeys_alert") or None
    if anomaly > 0 or alert:
        clauses, acts = [], []
        if anomaly > 0:
            clauses.append("出现 %d 次异常登录（陌生密钥或密码登录成功）"
                           % anomaly)
            acts.append("打开主机安全，核对授权密钥名单，"
                        "确认每一把钥匙的来历")
        if alert:
            bits = []
            added = _alert_total(alert.get("added"))
            removed = _alert_total(alert.get("removed"))
            if added:
                bits.append("新增 %d 把" % added)
            if removed:
                bits.append("移除 %d 把" % removed)
            clauses.append("授权密钥名单有变动（%s）" % "、".join(bits))
            acts.append("确认钥匙变动是不是你本人操作；"
                        "不是，立即移除不明钥匙")
        grade = {"level": "D",
                 "what": "%s。" % "；".join(clauses),
                 "action": "立即处理：" + "；".join(acts) + "。"}
        _done = True
        if anomaly > 0:
            _done = _done and entry.get("anomaly_done") is True
        if alert:
            _done = _done and entry.get("authkeys_done") is True
        if _done:
            grade["done"] = True
            if anomaly > 0 and alert:
                grade["done_text"] = "已处理：异常登录与密钥变动均已核对完毕。"
            elif alert:
                grade["done_text"] = "已处理：密钥变动已核对完毕。"
            else:
                grade["done_text"] = "已处理：异常登录已核对完毕。"
        return grade
    failed = int(entry.get("ssh_failed") or 0)
    panel_failed = int((entry.get("panel") or {}).get("failed") or 0)
    banned = int((entry.get("fail2ban") or {}).get("banned_window") or 0)
    if failed >= 10 or panel_failed > 0 or banned > 0:
        clauses, act = [], ""
        top = (entry.get("ssh_failed_top") or [{}])[0]
        if failed >= 10:
            clause = "SSH 登录失败 %d 次" % failed
            if top.get("ip"):
                clause += "（主要来源 %s）" % top.get("ip")
            clauses.append(clause)
            if top.get("ip"):
                act = ("核对 SSH 失败来源 %s 是否本人；不是本人，封禁该 IP。"
                       % top.get("ip"))
        if panel_failed > 0:
            clauses.append("宝塔面板登录失败 %d 次" % panel_failed)
            if not act:
                act = "核对面板登录失败是否本人输错；不是，立即修改面板密码。"
        if banned > 0:
            clauses.append("fail2ban 本时段封禁 %d 次" % banned)
            if not act:
                act = "fail2ban 已自动封禁。打开下方明细，核对被封来源。"
        return {"level": "C",
                "what": "%s。" % "；".join(clauses),
                "action": act or "打开下方明细，逐项核对。"}
    stranger = int(entry.get("ssh_stranger") or 0)
    if failed > 0 or stranger > 0:
        whats, acts = [], []
        if failed > 0:
            w = "SSH 登录失败 %d 次" % failed
            top = (entry.get("ssh_failed_top") or [{}])[0]
            if top.get("ip"):
                w += "（主要来源 %s）" % top.get("ip")
            whats.append(w + "，均未成功")
            acts.append("失败登录无需操作，只是有人试门，未得手")
        if stranger > 0:
            whats.append("有 %d 次已授权密钥从陌生归属地成功登录"
                         % stranger)
            acts.append("陌生归属地若是本人或同事的新地点，告知任一 "
                        "Agent 即可取消标记；不认识的来源立即处理")
        return {"level": "B", "what": "；".join(whats) + "。",
                "action": "；".join(acts) + "。"}
    return {"level": "A", "what": "本时段风平浪静，登录全部正常。",
            "action": "无需任何操作。"}


def _grade_host(key, entry, now):
    """等级回退：主机 D 的成因（异常登录 /
    密钥变动）全部核销时，回退到去掉这些成因后的等级（C/B/A），
    已处理说明随档附上；未全部核销则保持 D 不变。"""
    g = _grade_host_impl(key, entry, now)
    if g.get("level") == "D" and g.get("done"):
        e2 = dict(entry or {})
        e2["ssh_anomaly"] = 0
        e2["authkeys_alert"] = None
        g2 = _grade_host_impl(key, e2, now)
        g2["done"] = True
        g2["done_text"] = g["done_text"]
        return g2
    return g


def _compute_grades(result, hosts):
    hosts = hosts or {}
    now = datetime.now()
    return {
        "web": _grade_web(result),
        "host1": _grade_host("host1", hosts.get("host1"), now),
        "host2": _grade_host("host2", hosts.get("host2"), now),
    }



# ================= 自动封禁（单 IP 7 天内累计攻击 >=100 自动进黑名单） =================
# 阈值与评级 C 线一致。计数口径与看板完全相同
# （write_security_data 的 per_ip：已过滤图片请求、已排除本人/工具出口/
# 正常爬虫、只含真实 IP）。命中后写入 nginx 的 blocklist.conf（http 级
# deny，realip 还原真实 IP 后生效），nginx -t 通过才 reload；已在名单
# 里的 IP 跳过（幂等），手动条目不动。状态存 __AUTOBAN_STATE_PATH__，
# 看板 JSON 的 autobans 字段只取 7 天累计达到封禁线的记录（今天封的当天即显示）；状态文件里的封禁记录仍跨天保留。
# 拉长只影响封禁执行：排行、统计、评级（含封禁线阶梯）仍按本时段口径，
# 不受 7 天累计影响。
# 本节任何异常都不得影响看板数据生成与日报邮件。
import subprocess

_AUTOBAN_THRESHOLD = 100
_BLOCKLIST_PATH = "__BLOCKLIST_CONF__"
_AUTOBAN_STATE_PATH = "__AUTOBAN_STATE_PATH__"
_AUTOBAN_7D_PATH = "__AUTOBAN_7D_STATE_PATH__"
_AUTOBAN_7D_DAYS = 7
_NGINX_BIN = "/www/server/nginx/sbin/nginx"
_AUTOBAN_SAFE_NETS = [ipaddress.ip_network(c) for c in _RULES["autoban_safe_nets"]]
_LAST_AUTOBANS_NEW = []


def _autoban_eligible(ip, count):
    if count < _AUTOBAN_THRESHOLD:
        return False
    if ip in _EXCLUDE_IPS:
        return False
    try:
        ipobj = ipaddress.ip_address(ip)
    except ValueError:
        return False
    if ipobj.is_loopback or ipobj.is_link_local or ipobj.is_multicast \
            or ipobj.is_reserved or ipobj.is_unspecified:
        return False
    for nets in (_EXCLUDE_NETS, _CF_NETS, _AUTOBAN_SAFE_NETS):
        if any(ipobj in n for n in nets):
            return False
    return True


def _load_autoban_state():
    try:
        with open(_AUTOBAN_STATE_PATH, "r", encoding="utf-8") as f:
            state = json.load(f)
        if isinstance(state, list):
            return [e for e in state if isinstance(e, dict) and e.get("ip")]
    except Exception:
        pass
    return []


def _blocklist_denied():
    denied = set()
    try:
        with open(_BLOCKLIST_PATH, "r", encoding="utf-8") as f:
            for line in f:
                m = re.match(r"\s*deny\s+([0-9a-fA-F.:]+)\s*;", line)
                if m:
                    denied.add(m.group(1))
    except Exception:
        pass
    return denied


def _nginx_reload():
    t = subprocess.run([_NGINX_BIN, "-t"], stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT)
    if t.returncode != 0:
        print("Autoban: nginx -t failed: %s"
              % t.stdout.decode("utf-8", "ignore")[:300])
        return False
    r = subprocess.run([_NGINX_BIN, "-s", "reload"],
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if r.returncode != 0:
        print("Autoban: nginx reload failed: %s"
              % r.stdout.decode("utf-8", "ignore")[:300])
        return False
    return True


def _load_7d_state():
    """7 天累计状态：{统计日: {ip: 当日攻击次数}}，统计日为窗口起始日。"""
    try:
        with open(_AUTOBAN_7D_PATH, "r", encoding="utf-8") as f:
            state = json.load(f)
        if isinstance(state, dict):
            return {k: v for k, v in state.items() if isinstance(v, dict)}
    except Exception:
        pass
    return {}


def _save_7d_state(state):
    try:
        tmp = _AUTOBAN_7D_PATH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(state, f, ensure_ascii=False, indent=2)
        os.rename(tmp, _AUTOBAN_7D_PATH)
    except Exception as e:
        print("Autoban 7d: cannot save state: %s" % e)


def _scan_day_counts(day_start, day_end):
    """统计一个窗口日（07:00 → 次日 07:00）内各 IP 的攻击次数。

    与 write_security_data 主扫描完全相同的过滤口径（图片请求、博客
    分类页、example.com cgi-bin、白名单 IP、助手出口、良性爬虫、CF 节点
    一律不计为攻击者），只返回 {ip: count}。仅用于回填 7 天累计状态，
    主扫描不动。返回 (counts, ok)：扫描中途出错时 ok 为 False，调用
    方不保存该日、下次再试。
    """
    per_ip = Counter()
    try:
        for fname in sorted(os.listdir(WWWLOGS_DIR)):
            if not fname.endswith(".log") or fname.endswith(".error.log"):
                continue
            site = fname[:-4]
            try:
                f = open(os.path.join(WWWLOGS_DIR, fname), "r",
                         encoding="utf-8", errors="ignore")
            except Exception:
                continue
            with f:
                for line in f:
                    m = _LOG_RE.match(line)
                    if not m:
                        continue
                    ip, ts_raw, method, target, status, size_raw, ua = m.groups()
                    ts = _parse_log_time(ts_raw)
                    if ts is None or not (day_start <= ts < day_end):
                        continue
                    if _IMAGE_RE.search(target):
                        continue
                    if (site == "blog.example.com" and target.split("?", 1)[0] in _BLOG_EXACT_PATHS) or _TAXONOMY_RE.match(target.split("?", 1)[0]):
                        continue
                    if site == "example.com" and _OWN_CGI_RE.search(target.split("?", 1)[0]):
                        continue
                    if not _ATTACK_RE.search(target):
                        continue
                    if ip in _EXCLUDE_IPS:
                        continue
                    try:
                        ipobj = ipaddress.ip_address(ip)
                    except ValueError:
                        continue
                    if any(ipobj in n for n in _EXCLUDE_NETS):
                        continue
                    if _GOOD_BOT_RE.search(ua or ""):
                        continue
                    if any(ipobj in n for n in _CF_NETS):
                        continue
                    per_ip[ip] += 1
    except Exception as e:
        print("Autoban 7d: backfill scan failed: %s: %s"
              % (type(e).__name__, e))
        return dict(per_ip), False
    return dict(per_ip), True


def _update_7d_state(start, attackers):
    """记下本窗口的累计次数，回填缺失的过去 6 天，剪到最近 7 天，
    返回 7 天累计 [{"ip": ip, "count": n}]（按次数降序）。

    当日条目每次用本窗口的累计值整体覆盖（不是累加），与主扫描
    同一口径；07:00–07:29 间窗口仍是昨日，补的就是昨日的最终 24h。
    """
    state = _load_7d_state()
    day_key = start.strftime("%Y-%m-%d")
    state[day_key] = {a["ip"]: int(a.get("count") or 0)
                      for a in (attackers or []) if a.get("ip")}
    for back in range(1, _AUTOBAN_7D_DAYS):
        d = start - timedelta(days=back)
        k = d.strftime("%Y-%m-%d")
        if k not in state:
            counts, ok = _scan_day_counts(d, d + timedelta(days=1))
            if ok:
                state[k] = counts
    cutoff = (start - timedelta(days=_AUTOBAN_7D_DAYS - 1)).strftime("%Y-%m-%d")
    state = {k: v for k, v in state.items() if k >= cutoff}
    _save_7d_state(state)
    sums = Counter()
    for day in state.values():
        for ip, c in day.items():
            sums[ip] += int(c or 0)
    return [{"ip": ip, "count": c} for ip, c in sums.most_common()]


def _apply_autobans(attackers):
    """返回 (autobans 全量状态, 本次新增列表)。失败时不抛异常。"""
    state = _load_autoban_state()
    state_ips = {e["ip"] for e in state}
    denied = _blocklist_denied()
    today = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    new = []
    for a in attackers or []:
        ip = a.get("ip")
        cnt = a.get("count") or 0
        if not ip or ip in denied or ip in state_ips:
            continue
        if not _autoban_eligible(ip, cnt):
            continue
        new.append({"ip": ip, "count": cnt, "at": today})
    if not new:
        return state, []
    try:
        with open(_BLOCKLIST_PATH, "r", encoding="utf-8") as f:
            original = f.read()
    except Exception as e:
        print("Autoban: cannot read blocklist: %s" % e)
        return state, []
    try:
        with open(_BLOCKLIST_PATH, "a", encoding="utf-8") as f:
            for b in new:
                f.write("# auto-ban %s: %d attack requests in 7 days\n"
                        % (b["at"], b["count"]))
                f.write("deny %s;\n" % b["ip"])
    except Exception as e:
        print("Autoban: cannot write blocklist: %s" % e)
        return state, []
    if not _nginx_reload():
        # 配置没通过或没生效：还原名单文件，不留下未生效的条目。
        try:
            with open(_BLOCKLIST_PATH, "w", encoding="utf-8") as f:
                f.write(original)
        except Exception:
            pass
        return state, []
    state = state + new
    try:
        tmp = _AUTOBAN_STATE_PATH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(state, f, ensure_ascii=False, indent=2)
        os.rename(tmp, _AUTOBAN_STATE_PATH)
    except Exception as e:
        print("Autoban: cannot save state: %s" % e)
    print("Autoban: added %s"
          % ", ".join("%s (%d)" % (b["ip"], b["count"]) for b in new))
    return state, new


def _parse_ban_time(s):
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M"):
        try:
            return datetime.strptime(str(s or ""), fmt)
        except ValueError:
            continue
    return None


def _window_autobans(state, attackers, window_start, window_end):
    """看板只显示本统计时段内新封的 IP：
    封禁时间落在当前统计时段 [07:00, 运行时刻] 内的才显示；此前
    时段封的本时段不再出现（封禁本身仍在 nginx 黑名单里永久生效，
    状态文件里的记录也仍跨天保留）。手动封禁的 IP 不在此列——全量
    名单在 nginx blocklist.conf 里。"""
    heavy = {}
    for a in (attackers or []):
        ip = a.get("ip")
        cnt = int(a.get("count") or 0)
        if ip and cnt >= _AUTOBAN_THRESHOLD:
            heavy[ip] = cnt
    out = []
    for e in (state or []):
        if e.get("ip") not in heavy:
            continue
        ban_dt = _parse_ban_time(e.get("at"))
        if ban_dt is None:
            continue
        # 上限放宽 10 分钟：本轮新封的 IP，其 at 是封禁执行时刻，
        # 比本轮开始时算出的 window_end 晚几秒，须含进来。
        if window_start <= ban_dt < window_end + timedelta(minutes=10):
            out.append(e)
    return out


def write_security_data():
    start, end = _security_window()
    result = {
        "window_start": start.strftime("%Y-%m-%d %H:%M"),
        "window_end": end.strftime("%Y-%m-%d %H:%M"),
        "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "total_attack_requests": 0,
        "via_cf_edges": 0,
        "distinct_attacker_ips": 0,
        "top_target_site": None,
        "site_stats": [],
        "breach": {"suspected": False, "count": 0, "incidents": []},
        "attackers": [],
    }
    try:
        if not _RULES_OK:
            raise ValueError("dashboard rules unknown")
        per_ip = {}
        site_totals = Counter()
        all_site_totals = Counter()
        candidates = []
        home_sizes = {}
        follow_index = {}
        total = 0
        via_cf = 0
        for fname in sorted(os.listdir(WWWLOGS_DIR)):
            if not fname.endswith(".log") or fname.endswith(".error.log"):
                continue
            site = fname[:-4]
            try:
                f = open(os.path.join(WWWLOGS_DIR, fname), "r",
                         encoding="utf-8", errors="ignore")
            except Exception:
                continue
            with f:
                for line in f:
                    m = _LOG_RE.match(line)
                    if not m:
                        continue
                    ip, ts_raw, method, target, status, size_raw, ua = m.groups()
                    ts = _parse_log_time(ts_raw)
                    if ts is None or not (start <= ts < end):
                        continue
                    if (method == "GET" and status == "200"
                            and target in ("/", "/index.html")):
                        home_sizes.setdefault(site, Counter())[size_raw] += 1
                    # 图片请求直接跳过：老图外链、抓图机器人等正常
                    # 请求的路径常带 wp-content 等特征，会被误判。
                    if _IMAGE_RE.search(target):
                        continue
                    # 博客分类/标签页同理：名字里带 wordpress 等词的
                    # 本站内容页不是攻击（Claude-SearchBot 抓 /tags/wordpress/ 误报）。
                    if (site == "blog.example.com" and target.split("?", 1)[0] in _BLOG_EXACT_PATHS) or _TAXONOMY_RE.match(target.split("?", 1)[0]):
                        continue
                    # example.com 的 cgi-bin 路径同理：纯静态站没有 CGI
                    # 程序，命中的只是水印工具自带目录的公开文件。
                    if site == "example.com" and _OWN_CGI_RE.search(target.split("?", 1)[0]):
                        continue
                    if not _ATTACK_RE.search(target):
                        continue
                    if ip in _EXCLUDE_IPS:
                        continue
                    try:
                        ipobj = ipaddress.ip_address(ip)
                    except ValueError:
                        continue
                    if any(ipobj in n for n in _EXCLUDE_NETS):
                        continue
                    if _GOOD_BOT_RE.search(ua or ""):
                        continue
                    total += 1
                    # CMS 后台（/md/、/api/）单独成站，与站点前台分开计数、
                    # 分开归属（事件与攻击者的站点标注同样用 eff_site）。
                    eff_site = site
                    if site == "blog.example.com":
                        _path = target.split("?", 1)[0]
                        if (_path == "/md" or _path.startswith("/md/")
                                or _path == "/api" or _path.startswith("/api/")):
                            eff_site = "blog-cms"
                    # 全来源按站计数（含经 Cloudflare 节点转发的攻击）：
                    # 回答「哪些站被打了」，与攻击者是谁无关。
                    all_site_totals[eff_site] += 1
                    follow_index.setdefault(target, []).append((ts, status))
                    is_cf = any(ipobj in n for n in _CF_NETS)
                    if status not in ("404", "403"):
                        try:
                            size_val = int(size_raw)
                        except (TypeError, ValueError):
                            size_val = None
                        candidates.append({
                            "ts": ts, "ip": ip, "site": eff_site, "method": method,
                            "target": target, "status": status, "size": size_val,
                            "via_cf": is_cf, "raw": line.strip()[:300],
                        })
                    if is_cf:
                        # 真实 IP 还原（2026-11-21 15:55）之前的 Cloudflare 节点，
                        # 或无法归属的来源：只计总数，不列为攻击者。
                        via_cf += 1
                        continue
                    entry = per_ip.get(ip)
                    if entry is None:
                        entry = per_ip[ip] = {
                            "count": 0, "sites": Counter(),
                            "paths": Counter(), "first": ts, "last": ts,
                        }
                    entry["count"] += 1
                    entry["sites"][eff_site] += 1
                    entry["paths"][target] += 1
                    site_totals[eff_site] += 1
                    if ts < entry["first"]:
                        entry["first"] = ts
                    if ts > entry["last"]:
                        entry["last"] = ts
        incidents = _build_incidents(candidates, home_sizes, follow_index)
        ordered = sorted(per_ip.items(), key=lambda kv: -kv[1]["count"])
        locs = _geolocate([ip for ip, _ in ordered])
        attackers = []
        for ip, e in ordered:
            top = e["paths"].most_common(10)
            attackers.append({
                "ip": ip,
                "location": locs.get(ip, ""),
                "count": e["count"],
                "sites": dict(e["sites"].most_common()),
                "top_paths": [{"path": p, "count": c} for p, c in top],
                "top_paths_more": max(0, len(e["paths"]) - len(top)),
                "first_seen": e["first"].strftime("%Y-%m-%d %H:%M:%S"),
                "last_seen": e["last"].strftime("%Y-%m-%d %H:%M:%S"),
            })
        # 已核销的需留意事件在数据里打标，前台卡片据此显示
        # 「✓ 已处理」——核销状态不再只体现在评级卡上。
        _res = _load_resolutions()
        for _inc in incidents:
            if _incident_resolved(_inc, _res):
                _inc["resolved"] = True
                for _r in _res:
                    if (_r.get("signature") == _inc.get("signature")
                            and _r.get("site") == _inc.get("site")
                            and _r.get("date")
                            == (_inc.get("first_seen") or "")[:10]):
                        _inc["resolution_note"] = _r.get("note") or ""
                        break
        result.update({
            "total_attack_requests": total,
            "via_cf_edges": via_cf,
            "distinct_attacker_ips": len(attackers),
            "top_target_site": (site_totals.most_common(1)[0][0]
                                if site_totals else None),
            "site_stats": [
                {"site": s, "count": c}
                for s, c in sorted(all_site_totals.items(),
                                    key=lambda kv: (-kv[1], kv[0]))
            ],
            "breach": {
                "suspected": len(candidates) > 0,
                "count": len(candidates),
                "incidents": incidents,
            },
            "attackers": attackers,
        })
        if via_cf > 0:
            result["note"] = (
                "本时段有 %d 条攻击请求的来源是 Cloudflare 节点 IP"
                "（真实 IP 还原于 2026-11-21 15:55 才开启），"
                "无法归属到真实攻击者，未列入下表。" % via_cf
            )
    except Exception as e:
        result["error"] = "%s: %s" % (type(e).__name__, e)
    hosts = {}
    try:
        _hs, _he = _host_window()
        hosts["host1"] = collect_host_entry(_hs, _he)
    except Exception as e:
        print("Host data (host1) failed: %s: %s" % (type(e).__name__, e))
    _host2_data = _read_host2()
    if _host2_data is not None:
        hosts["host2"] = _host2_data
    if hosts:
        result["hosts"] = hosts
    try:
        result["grades"] = _compute_grades(result, hosts)
    except Exception as e:
        print("Grades failed: %s: %s" % (type(e).__name__, e))
    if not _RULES_OK or "error" in result:
        # 规则不可信或扫描失败：网站侧写未知，不参与评级。
        g = result.get("grades")
        if not isinstance(g, dict):
            g = {}
            result["grades"] = g
        g["web"] = _grade_web_unknown()
        result["unknown"] = True
    # 封禁口径 7 天累计；排行、统计、评级仍用本时段。
    # 规则不可信时不更新 7 天状态（空数据会覆盖当日计数），
    # 但封禁不停——封禁写 nginx 黑名单、不依赖看板 JSON，
    # 按已有 7 天累计（过去可信数据）继续执行，只拦公网 IP，
    # 内网/组网地址永不封（安全底线，与规则配置无关）。
    if not _RULES_OK:
        try:
            _sums = Counter()
            for _day in _load_7d_state().values():
                for _ip, _c in _day.items():
                    _sums[_ip] += int(_c or 0)
            # __TAILSCALE_NET__（组网/CGNAT，Python 3.6 的 is_private 不认）与
            # __LAN_NET__（站主局域网，不在 RFC1918 内）永不封。
            _never_ban = (_net("__TAILSCALE_NET__"),
                          _net("__LAN_NET__"))
            _ban_src = []
            for _ip, _c in _sums.most_common():
                try:
                    _o = ipaddress.ip_address(_ip)
                except ValueError:
                    continue
                if (_o.is_private or _o.is_loopback or _o.is_link_local
                        or _o.is_multicast or _o.is_reserved
                        or _o.is_unspecified
                        or any(_o in _n for _n in _never_ban)):
                    continue
                _ban_src.append({"ip": _ip, "count": _c})
            _ab_all, _ab_new = _apply_autobans(_ban_src)
            result["autobans"] = _window_autobans(_ab_all, _ban_src, start, end)
            _LAST_AUTOBANS_NEW[:] = _ab_new
        except Exception as e:
            print("Autoban failed: %s: %s" % (type(e).__name__, e))
            try:
                result["autobans"] = _window_autobans(
                    _load_autoban_state(), [], start, end)
            except Exception:
                result["autobans"] = []
    else:
        try:
            _seven = _update_7d_state(start, result.get("attackers", []))
        except Exception as e:
            print("Autoban 7d failed: %s: %s" % (type(e).__name__, e))
            _seven = None
        try:
            _ban_src = _seven if _seven is not None else result.get("attackers", [])
            _ab_all, _ab_new = _apply_autobans(_ban_src)
            result["autobans"] = _window_autobans(_ab_all, _ban_src, start, end)
            _LAST_AUTOBANS_NEW[:] = _ab_new
        except Exception as e:
            print("Autoban failed: %s: %s" % (type(e).__name__, e))
            result["autobans"] = _window_autobans(
                _load_autoban_state(), result.get("attackers", []), start, end)
    out = str(dashboard_report_path())
    tmp = out + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(result, f, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o644)
    try:
        import pwd
        import grp
        os.chown(tmp, pwd.getpwnam("www").pw_uid, grp.getgrnam("www").gr_gid)
    except Exception:
        pass
    os.rename(tmp, out)
    print("Security data written: %s" % out)


