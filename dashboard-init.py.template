            _confirm_location(sys.argv[2])
        elif sys.argv[1:] == ["--list-stranger"]:
            _list_stranger()
        elif len(sys.argv) == 5 and sys.argv[1] == "--resolve-incident":
            _record_resolution(sys.argv[2], sys.argv[3], sys.argv[4])
        elif not sys.argv[1:]:
            daily_report()
        else:
            sys.exit("Unsupported arguments")
