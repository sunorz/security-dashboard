def _net(s):
    """Parse a network placeholder. An unfilled/invalid value becomes
    TEST-NET-1 (192.0.2.0/24, a documentation range that never carries real
    traffic), so the program still runs and the entry simply never matches.
    Fill in a real network only if you have one; otherwise leave it."""
    try:
        return ipaddress.ip_network(s)
    except ValueError:
        return ipaddress.ip_network("192.0.2.0/24")


