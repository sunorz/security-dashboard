def _host_event_add(events, ip, user, method, ok, ts, fp=""):
    key = (ip, user, method, ok, fp)
    e = events.get(key)
    if e is None:
        events[key] = [1, ts, ts]
    else:
        e[0] += 1
        if ts < e[1]:
            e[1] = ts
        if ts > e[2]:
            e[2] = ts
_HOST_SECURE_TS_RE = re.compile(r"^([A-Z][a-z]{2})\s+(\d{1,2}) (\d{2}):(\d{2}):(\d{2})")
