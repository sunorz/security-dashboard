def _host_window():
    """统计时段（CST），与 host 1 的看板生成时段对齐（用户 2026-11-24 定）：
    07:00 为界、07:30 才翻页，结束封顶于起始日 22:00；07:00–07:29:59
    间为上一时段完整累计（昨日 07:00 → 今日 07:00）。"""
    now = datetime.now()
    start = now.replace(hour=7, minute=0, second=0, microsecond=0)
    if now < start:
        start -= timedelta(days=1)
    if now < start + timedelta(minutes=30):
        return start - timedelta(days=1), start
    end = min(now, start + timedelta(hours=15))
    return start, end


def _host_secure_ts(line, now):
    m = _HOST_SECURE_TS_RE.match(line)
    if not m:
        return None
    mon, day, hh, mm, ss = m.groups()
    if mon not in _HOST_MONTH_NUM:
        return None
    try:
        ts = datetime(now.year, _HOST_MONTH_NUM[mon], int(day),
                      int(hh), int(mm), int(ss))
    except ValueError:
        return None
    if ts > now + timedelta(days=1):
        ts = ts.replace(year=now.year - 1)
    return ts


def _host_iter_secure():
    paths = ["/var/log/secure"]
    try:
        for name in sorted(os.listdir("/var/log")):
            if name.startswith("secure-") or name.startswith("secure."):
                paths.append(os.path.join("/var/log", name))
    except Exception:
        pass
    for path in paths:
        try:
            if path.endswith(".gz"):
                fh = gzip.open(path, "rt", encoding="utf-8", errors="ignore")
            else:
                fh = open(path, "r", encoding="utf-8", errors="ignore")
        except Exception:
            continue
        with fh:
            for line in fh:
                yield line



