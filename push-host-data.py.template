def _panel_known(ip):
    try:
        addr = ipaddress.ip_address(ip)
    except ValueError:
        return False
    if addr.is_loopback:
        return True
    return any(addr in n for n in _PANEL_KNOWN_NETS)


_IP_BASELINE_FILE = "/root/.hostsec-ip-baseline.json"
_USUALLY_KEY_FILE = "/root/usually-key.json"


def _load_loc_state():
    """读取归属地基线（v2：known_locs + pending）。

    返回 (state, first_run, old_ips)：文件不存在 → first_run=True；
    旧版 {"ips": [...]} → old_ips 带回旧基线 IP 清单，交由
    _migrate_old_baseline 用当前行数据（必要时查归属地）播种。"""
    try:
        with open(_IP_BASELINE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception:
        return {"known_locs": [], "pending": []}, True, None
    if isinstance(data, dict) and "known_locs" in data:
        return ({"known_locs": list(data.get("known_locs") or []),
                 "pending": list(data.get("pending") or [])},
                False, None)
    return ({"known_locs": [], "pending": []}, False,
            list((data or {}).get("ips") or []))


def _save_loc_state(state):
    try:
        tmp = _IP_BASELINE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"known_locs": state["known_locs"],
                       "pending": state["pending"],
                       "saved_at": datetime.now().strftime(
                           "%Y-%m-%d %H:%M:%S")},
                      f, ensure_ascii=False)
        os.rename(tmp, _IP_BASELINE_FILE)
    except Exception:
        pass


def _migrate_old_baseline(old_ips, rows):
    """旧 IP 基线迁移：旧基线 IP 在当前行里出现过的，取其归属地为
    已知；局域网段直接记「局域网」；其余公网 IP 若本模块有
    _geolocate 就查一次，都没有就等它下次出现时按新规则判定。"""
    known = set()
    by_ip = {}
    for e in rows:
        ip = e.get("ip")
        loc = e.get("loc") or ""
        if ip and loc:
            by_ip.setdefault(ip, loc)
    pubs = []
    for ip in old_ips:
        if "/" in ip or ip.startswith(("__LAN_PREFIX__", "192.168.", "10.")):
            known.add("局域网")
        elif ip in by_ip:
            known.add(by_ip[ip])
        else:
            pubs.append(ip)
    geo = globals().get("_geolocate")
    if pubs and geo is not None:
        try:
            for loc in geo(pubs).values():
                if loc:
                    known.add(loc)
        except Exception:
            pass
    return known


def _flag_new_ip_logins(ok_list, ssh_events):
    """陌生归属地标记（所有者 2026-11-24 改定，取代按 IP 判定）：
    非助手出口（bulk 为空）的密钥成功登录，按归属地 loc（国家 ·
    城市整串）判定——已知归属地换 IP 不报；第一次出现的归属地标
    stranger、note=「陌生归属地」，并记入 pending 持久保存，之后
    每次运行继续标，直到维护者用 --confirm-location 取消（转入
    已知，并生成 usually-key.json 记录）。归属地为空（查询失败）
    不判定：查询失败不等于地理变化。基线存 _IP_BASELINE_FILE
    （v2：known_locs + pending，与密钥状态文件分开，互不覆盖）。"""
    rows = list(ok_list or []) + list(ssh_events or [])
    state, first_run, old_ips = _load_loc_state()
    known = set(state["known_locs"])
    pending = {p["loc"]: p for p in state["pending"]}
    changed = False
    if old_ips is not None:
        known |= _migrate_old_baseline(old_ips, rows)
        changed = True
    for e in rows:
        if not (e.get("ok") and e.get("method") == "key"
                and not e.get("anomaly") and not e.get("bulk")):
            continue
        loc = e.get("loc") or ""
        if not loc:
            # 归属地为空分两种（所有者 2026-11-24 定）：只是未知
            # （查过但无结果）→ 什么都不显示；查询真失败
            # （geo_failed）→ 前台留一行「归属地查询失败」。
            # 两种都不当作地理变化、不进基线。
            if e.get("geo_failed") and not e.get("note"):
                e["note"] = "归属地查询失败"
            continue
        if loc in ("局域网", "组网", "本机"):
            # 内网/组网/本机标签不是地理归属地，恒已知：
            # 局域网 Xshell、宝塔面板本机终端都走这类来源。
            continue
        if loc in known:
            continue
        p = pending.get(loc)
        if p is None:
            if first_run:
                known.add(loc)
                changed = True
                continue
            p = pending[loc] = {
                "loc": loc,
                "since": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "ips": [], "fps": []}
            changed = True
        ip = e.get("ip")
        if ip and ip not in p["ips"]:
            p["ips"].append(ip)
            changed = True
        fp = e.get("fp")
        if fp and fp not in p["fps"]:
            p["fps"].append(fp)
            changed = True
        e["stranger"] = True
        e["note"] = "陌生归属地"
    state["known_locs"] = sorted(known)
    state["pending"] = sorted(pending.values(), key=lambda p: p["loc"])
    if changed or first_run:
        _save_loc_state(state)


def _confirm_location(loc):
    """维护者确认某归属地为常驻/长期使用：取消其陌生标记、转入
    已知归属地，并把这次确认记入 usually-key.json（所有者
    2026-11-24 定：key 的陌生标记被取消时生成 usually-key.json）。
    用法：push-host-data.py --confirm-location "国家 · 城市"。"""
    state, _fr, _old = _load_loc_state()
    hit = None
    rest = []
    for p in state["pending"]:
        if p["loc"] == loc:
            hit = p
        else:
            rest.append(p)
    state["pending"] = rest
    if loc not in state["known_locs"]:
        state["known_locs"] = sorted(state["known_locs"] + [loc])
    _save_loc_state(state)
    rec = {"loc": loc,
           "ips": (hit or {}).get("ips") or [],
           "fps": (hit or {}).get("fps") or [],
           "since": (hit or {}).get("since"),
           "confirmed_at": datetime.now().strftime(
               "%Y-%m-%d %H:%M:%S")}
    try:
        try:
            with open(_USUALLY_KEY_FILE, "r", encoding="utf-8") as f:
                uk = json.load(f)
            if not isinstance(uk, list):
                uk = []
        except Exception:
            uk = []
        uk.append(rec)
        tmp = _USUALLY_KEY_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(uk, f, ensure_ascii=False, indent=1)
        os.rename(tmp, _USUALLY_KEY_FILE)
    except Exception as e:
        print("usually-key.json write failed: %s" % e)
    print("Confirmed location: %s (was pending: %s)" % (loc, bool(hit)))


