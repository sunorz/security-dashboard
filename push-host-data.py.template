def _authkeys_change(auth_fps, letters=None):
    """把本次授权指纹集合与上次运行保存的集合比对；有增删则返回告警。

    状态保存在 _HOST_STATE_FILE（不在网站目录内）。首次运行只建基线、
    不告警；每次运行都把当前集合存为新基线，所以同一次变动只报一次。"""
    cur = {u: sorted(s) for u, s in auth_fps.items()}
    prev = None
    prev_letters = {}
    try:
        with open(_HOST_STATE_FILE, "r", encoding="utf-8") as f:
            _state = json.load(f)
            prev = _state.get("users")
            prev_letters = _state.get("letters") or {}
    except Exception:
        prev = None
    # 旧状态里存的是单字母标记，统一翻译成三字母代码再用（仅显示
    # 标签受影响；增删判定只比对指纹集合，不受改名影响）。
    _LEGACY_WHO = {"S": "OWN", "Y": "AGA", "P": "AGB",
                   "B": "BAK", "L": "LAN"}
    if prev_letters:
        prev_letters = {
            _u: {_f: _LEGACY_WHO.get(_l, _l)
                 for _f, _l in _m.items()}
            for _u, _m in prev_letters.items()}
    _cur_letters = {}
    if letters:
        for (_u, _f), _l in letters.items():
            _cur_letters.setdefault(_u, {})[_f] = _l
    try:
        tmp = _HOST_STATE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"users": cur, "letters": _cur_letters,
                       "saved_at": datetime.now().strftime(
                           "%Y-%m-%d %H:%M:%S")},
                      f, ensure_ascii=False)
        os.rename(tmp, _HOST_STATE_FILE)
    except Exception:
        pass
    if prev is None:
        return None
    _add_c = {}
    _rem_c = {}
    _add_fps = {}
    changed_users = []
    for u in set(cur) | set(prev):
        new = set(cur.get(u, []))
        old = set(prev.get(u, []))
        if new != old:
            changed_users.append(u)
            for _fp in sorted(new - old):
                _w = (letters or {}).get((u, _fp), "⚠")
                _add_c[_w] = _add_c.get(_w, 0) + 1
                _add_fps.setdefault(u, []).append(_fp)
            for _fp in sorted(old - new):
                _w = (prev_letters.get(u) or {}).get(_fp, "⚠")
                _rem_c[_w] = _rem_c.get(_w, 0) + 1
    added = [{"who": w, "count": n} for w, n in sorted(_add_c.items())]
    removed = [{"who": w, "count": n} for w, n in sorted(_rem_c.items())]
    if not added and not removed:
        return None
    mt = None
    for u in changed_users:
        try:
            home = pwd.getpwnam(u).pw_dir
            t = os.path.getmtime(os.path.join(home, ".ssh", "authorized_keys"))
            if mt is None or t > mt:
                mt = t
        except Exception:
            pass
    return {"added": added, "removed": removed,
            "_added_fps": _add_fps,
            "changed_at": (datetime.fromtimestamp(mt).strftime("%Y-%m-%d %H:%M")
                           if mt else "")}



def _fp_assigned(letters, user, fp):
    """指纹在通道代码表里有真实归属（不是 ⚠）才算已识别。"""
    code = (letters or {}).get((user, fp))
    return bool(code) and code != "⚠"


def _authkeys_done(added_fps, auth_fps, letters):
    """授权密钥「新增」待办的已处理判定：每一个新增指纹，要么已不在
    该账号的 authorized_keys 里（已被移除），要么已在通道代码表里有
    归属（已识别），才算核对完毕。没有新增指纹（纯移除变动）时无法
    机器核对，返回 False，不冒充已处理。"""
    if not added_fps:
        return False
    for user, fps in added_fps.items():
        cur = (auth_fps or {}).get(user, set())
        for fp in fps:
            if fp in cur and not _fp_assigned(letters, user, fp):
                return False
    return True


def _anomaly_done(events, auth_fps, letters):
    """异常登录待办的已处理判定：陌生密钥成功的每一个指纹都已获得
    通道归属（已识别），才算核对完毕。密码方式成功登录没有机器可
    核对的终态，只要出现就返回 False（待办保留）。本时段无异常时
    返回 False（不适用）。"""
    seen = False
    for (_ip, user, method, ok, fp), _v in (events or {}).items():
        if not ok:
            continue
        if method != "key":
            return False
        if fp and fp not in (auth_fps or {}).get(user, set()):
            seen = True
            if not _fp_assigned(letters, user, fp):
                return False
    return seen

def _authorized_fingerprints():
    """各登录账号 authorized_keys 里公钥的 SHA256 指纹：{user: set(fp)}。

    「已知」只认密钥指纹，不认 IP、也不认登录次数：成功登录用的指纹
    不在该账号的授权集合里，就是异常。"""
    result = {}
    try:
        entries = pwd.getpwall()
    except Exception:
        entries = []
    for ent in entries:
        path = os.path.join(ent.pw_dir, ".ssh", "authorized_keys")
        fps = set()
        try:
            fh = open(path, "r", encoding="utf-8", errors="ignore")
        except Exception:
            continue
        with fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                toks = line.split()
                blob = None
                for i, tok in enumerate(toks[:-1]):
                    if tok in _KEY_TYPE_TOKENS:
                        blob = toks[i + 1]
                        break
                if not blob:
                    continue
                try:
                    raw = base64.b64decode(blob)
                    fp = base64.b64encode(
                        hashlib.sha256(raw).digest()).decode("ascii")
                except Exception:
                    continue
                fps.add(fp.rstrip("="))
        if fps:
            result[ent.pw_name] = fps
    return result


def _authorized_key_info():
    """各登录账号 authorized_keys 里公钥的指纹与注释：{user: {fp: comment}}。"""
    result = {}
    try:
        entries = pwd.getpwall()
    except Exception:
        entries = []
    for ent in entries:
        path = os.path.join(ent.pw_dir, ".ssh", "authorized_keys")
        keys = {}
        try:
            fh = open(path, "r", encoding="utf-8", errors="ignore")
        except Exception:
            continue
        with fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                toks = line.split()
                blob = None
                idx = None
                for i, tok in enumerate(toks[:-1]):
                    if tok in _KEY_TYPE_TOKENS:
                        blob = toks[i + 1]
                        idx = i
                        break
                if not blob:
                    continue
                try:
                    raw = base64.b64decode(blob)
                    fp = base64.b64encode(
                        hashlib.sha256(raw).digest()).decode("ascii")
                except Exception:
                    continue
                keys[fp.rstrip("=")] = " ".join(toks[idx + 2:])
        if keys:
            result[ent.pw_name] = keys
    return result


_KEY_LAN_NET = _net("__LAN_NET__")


def _key_src_class(ip):
    """SSH 来源的通道类别（只用于把钥匙归到使用者的字母标记）。"""
    if ip == "__AGENT_A_MESH_IP__":
        return "agent_a"
    if ip == "__AGENT_B_MESH_IP__":
        return "agent_b"
    try:
        addr = ipaddress.ip_address(ip)
    except ValueError:
        return "other"
    if any(addr in n for n in _HOST_BULK_NETS):
        return "agent_a"
    if addr in _KEY_LAN_NET:
        return "lan"
    if addr.is_loopback:
        return "local"
    return "other"


def _resolve_key_letters(key_info, events):
    """把每把授权钥匙归到一个三字母代码：{(user, fp): code}。

    AGA=助手 A、OWN=所有者、BAK=备份拉取、AGB=助手 B、LAN=局域网电脑；有授权但
    归不到任何通道的标 ⚠。依据是钥匙注释与本时段的实际使用来源
    （通道），与登录次数无关；已知/异常判定不走这里，仍只认指纹。"""
    classes = {}
    for (ip, user, method, ok, fp) in events:
        if ok and method == "key" and fp:
            classes.setdefault((user, fp), set()).add(_key_src_class(ip))
    letters = {}
    for user, fmap in key_info.items():
        for fp, comment in fmap.items():
            c = (comment or "").lower()
            seen = classes.get((user, fp), set())
            if user == "__PUSH_USER__" or "pull" in c or "backup" in c:
                letter = "BAK"
            elif "agent_b" in c:
                letter = "AGB"
            elif "__OWNER_NAME__".lower() in c:
                letter = "OWN"
            elif "agent_a" in c:
                letter = "AGA"
            elif "agent_a" in seen:
                letter = "AGA"
            elif "agent_b" in seen:
                letter = "AGB"
            elif "lan" in seen:
                letter = "LAN"
            else:
                letter = "⚠"
            letters[(user, fp)] = letter
    return letters


def _host_ssh_stats(start, end):
    now = datetime.now()
    failed = 0
    failed_ips = Counter()
    ok_ips = Counter()
    events = {}
    for line in _host_iter_secure():
        if " from " not in line:
            continue
        ts = _host_secure_ts(line, now)
        if ts is None or not (start <= ts < end):
            continue
        m = _HOST_SSH_FAIL_RE.search(line)
        if m:
            failed += 1
            _ip = m.group(1)
            failed_ips[_ip] += 1
            _em = _HOST_SSH_FAIL_EV_RE.search(line)
            if _em:
                _user = _em.group(2)
                _method = "key" if _em.group(1) == "publickey" else "password"
            else:
                _user = "-"
                _method = "key" if " publickey " in line else "password"
            _host_event_add(events, _ip, _user, _method, False, ts)
            continue
        m = _HOST_SSH_OK_RE.search(line)
        if m:
            _ip = m.group(1)
            ok_ips[_ip] += 1
            _em = _HOST_SSH_OK_EV_RE.search(line)
            _fp = ""
            if _em:
                _user = _em.group(2)
                _method = "key" if _em.group(1) == "publickey" else "password"
                if _method == "key" and _em.group(4):
                    _fp = _em.group(4).rstrip("=")
            else:
                _user = "-"
                _method = "key" if " publickey " in line else "password"
            _host_event_add(events, _ip, _user, _method, True, ts, _fp)

    def _known(ip):
        if ip in _HOST_KNOWN_IPS:
            return True
        try:
            addr = ipaddress.ip_address(ip)
        except ValueError:
            return False
        return any(addr in n for n in _HOST_KNOWN_NETS)

    return failed, failed_ips, ok_ips, _known, events


def _host_panel_stats(start, end):
    ok = 0
    failed = 0
    ips = Counter()
    try:
        conn = sqlite3.connect("file:%s?mode=ro" % _HOST_PANEL_DB, uri=True)
        try:
            rows = conn.execute(
                "SELECT log, addtime FROM logs WHERE type = '用户登录'")
            for logtext, addtime in rows:
                try:
                    ts = datetime.strptime(addtime, "%Y-%m-%d %H:%M:%S")
                except (TypeError, ValueError):
                    continue
                if not (start <= ts < end):
                    continue
                if "登录成功" in logtext:
                    ok += 1
                    m = _HOST_PANEL_IP_RE.search(logtext)
                    if m:
                        ips[m.group(1)] += 1
                elif "密码错误" in logtext or "登录失败" in logtext:
                    failed += 1
        finally:
            conn.close()
    except Exception:
        pass
    return {"ok": ok,
            "ok_ips": [{"ip": ip, "count": c, "known": _panel_known(ip)}
                       for ip, c in ips.most_common()],
            "failed": failed}


def _host_fail2ban_stats(start, end):
    banned_window = 0
    paths = ["/var/log/fail2ban.log"]
    try:
        for name in sorted(os.listdir("/var/log")):
            if name.startswith("fail2ban.log-") or name.startswith("fail2ban.log."):
                paths.append(os.path.join("/var/log", name))
    except Exception:
        pass
    for path in paths:
        try:
            if path.endswith(".gz"):
                fh = gzip.open(path, "rt", encoding="utf-8", errors="ignore")
            else:
                fh = open(path, "r", encoding="utf-8", errors="ignore")
        except Exception:
            continue
        with fh:
            for line in fh:
                m = _HOST_F2B_BAN_RE.match(line)
                if not m:
                    continue
                try:
                    ts = datetime(int(m.group(1)), int(m.group(2)),
                                  int(m.group(3)), int(m.group(4)),
                                  int(m.group(5)), int(m.group(6)))
                except ValueError:
                    continue
                if start <= ts < end:
                    banned_window += 1
    banned_now = 0
    try:
        out = subprocess.check_output(
            ["fail2ban-client", "status", "sshd"],
            stderr=subprocess.STDOUT, timeout=15).decode("utf-8", "ignore")
        m = re.search(r"Currently banned:\s*(\d+)", out)
        if m:
            banned_now = int(m.group(1))
    except Exception:
        pass
    return {"banned_now": banned_now, "banned_window": banned_window}


_GEO_FAILED = set()


def _host_geolocate(ips):
    """用 ip-api.com 批量查询归属地（国家 · 城市），与 host 1 生成器同口径。"""
    locs = {}
    for i in range(0, len(ips), 100):
        chunk = ips[i:i + 100]
        try:
            req = urllib.request.Request(
                "http://ip-api.com/batch?fields=status,country,city,query",
                data=json.dumps([{"query": ip} for ip in chunk]).encode("utf-8"),
                headers={"Content-Type": "application/json"},
            )
            with urllib.request.urlopen(req, timeout=30) as resp:
                for item in json.loads(resp.read().decode("utf-8")):
                    if item.get("status") == "success":
                        loc = item.get("country") or ""
                        city = item.get("city") or ""
                        if city:
                            loc = (loc + " · " + city) if loc else city
                        if loc:
                            locs[item.get("query")] = loc
        except Exception as e:
            _GEO_FAILED.update(chunk)
            print("Geolocation chunk failed: %s: %s"
                  % (type(e).__name__, e))
        if i + 100 < len(ips):
            time.sleep(2)
    return locs


def _host_ssh_lists(failed_ips, ok_ips, known, events, auth_fps,
                    letters=None):
    letters = letters or {}
    fp_letters = {}
    for (_u, _f), _l in letters.items():
        if _f not in fp_letters or fp_letters[_f] == "⚠":
            fp_letters[_f] = _l
    """把 SSH 来源整理成看板条目（公网 IP 只查一次归属地）：
    局域网（RFC1918、本机已知局域网段等）按 /24 合并、loc=局域网；组网（__MESH_NET_1__、__MESH_NET_2__）
    逐个保留、loc=组网；环回 loc=本机；公网逐个保留、loc=归属地。
    登录明细（events）按合并后的 IP 标签重新分组。
    成功登录的「已知」只认密钥指纹（auth_fps）：指纹不在该账号授权集合内、
    或密码方式成功登录，都标 anomaly；IP 基线只用于失败来源与无指纹的老日志行。"""
    resolved = {}
    resolved_app = {}

    def _resolve(ip):
        r = resolved.get(ip)
        if r is not None:
            return r
        try:
            addr = ipaddress.ip_address(ip)
        except ValueError:
            r = (ip, "", known(ip))
            resolved[ip] = r
            return r
        if isinstance(addr, ipaddress.IPv6Address):
            r = ((ip, "本机", known(ip)) if addr.is_loopback
                 else (ip, None, known(ip)))
        elif (addr in _HOST_MESH1_NET
                or any(addr in n for n in _HOST_MESH2_NETS)):
            r = (ip, "组网", known(ip))
            resolved_app[ip] = ("Mesh 1" if addr in _HOST_MESH1_NET
                                else "Mesh 2")
        elif addr.is_loopback:
            r = (ip, "本机", known(ip))
        elif (any(addr in n for n in _HOST_PRIVATE_NETS)
                or not addr.is_global
                or any(addr in n and n.prefixlen >= 24
                       for n in _HOST_KNOWN_NETS)):
            net = ipaddress.ip_network(ip + "/24", strict=False)
            r = (str(net), "局域网", known(str(net.network_address)))
        else:
            r = (ip, None, known(ip))
        resolved[ip] = r
        return r

    def _bulk(label):
        try:
            if "/" in label:
                addr = ipaddress.ip_network(label).network_address
            else:
                addr = ipaddress.ip_address(label)
        except ValueError:
            return None
        for n in _HOST_BULK_NETS:
            if addr in n:
                return str(n)
        return None

    def _group(counter):
        groups = {}
        seq = []
        for ip, c in counter.items():
            label, loc, kn = _resolve(ip)
            if label not in groups:
                groups[label] = {"ip": label, "count": 0,
                                 "known": kn, "loc": loc,
                                 "app": resolved_app.get(ip)}
                seq.append(label)
            groups[label]["count"] += c
        return groups, seq

    fgroups, fseq = _group(failed_ips)
    ogroups, oseq = _group(ok_ips)
    egroups = {}
    for (ip, user, method, ok, fp), (c, first, last) in events.items():
        label, loc, kn = _resolve(ip)
        key = (label, user, method, ok, fp)
        e = egroups.get(key)
        if e is None:
            e = egroups[key] = {"ip": label, "loc": loc, "user": user,
                                "app": resolved_app.get(ip),
                                "method": method, "ok": ok, "known": kn,
                                "fp": fp,
                                "count": 0, "first": first, "last": last}
        e["count"] += c
        if first < e["first"]:
            e["first"] = first
        if last > e["last"]:
            e["last"] = last

    pubs = sorted({ip for ip, r in resolved.items() if r[1] is None})
    if pubs:
        locs = _host_geolocate(pubs)
        for groups in (fgroups, ogroups):
            for e in groups.values():
                if e["loc"] is None:
                    e["loc"] = locs.get(e["ip"], "")
                    if not e["loc"] and e["ip"] in _GEO_FAILED:
                        e["geo_failed"] = True
        for e in egroups.values():
            if e["loc"] is None:
                e["loc"] = locs.get(e["ip"], "")
                if not e["loc"] and e["ip"] in _GEO_FAILED:
                    e["geo_failed"] = True

    # 成功登录按密钥指纹判定：指纹 in 该账号 authorized_keys 集合才算已知；
    # 密码方式成功、或指纹不在授权集合内，都是异常。次数不参与判定。
    ok_judge = {}
    for e in egroups.values():
        if e["ok"] and e["method"] == "key" and e["fp"]:
            e["key_known"] = e["fp"] in auth_fps.get(e["user"], set())
            e["anomaly"] = not e["key_known"]
            e["known"] = e["key_known"]
        elif e["ok"] and e["method"] == "key":
            e["key_known"] = None
            e["anomaly"] = False
        elif e["ok"]:
            e["key_known"] = False
            e["anomaly"] = True
            e["known"] = False
        else:
            e["key_known"] = None
            e["anomaly"] = False
        e["who"] = None
        if e["ok"] and e["method"] == "key" and e["fp"] and e.get("key_known"):
            e["who"] = letters.get((e["user"], e["fp"]))
        if e["ok"]:
            j = ok_judge.setdefault(
                e["ip"], {"fps": set(), "anomaly": False,
                          "verified": False, "has_key": False})
            if e["anomaly"]:
                j["anomaly"] = True
            if e["method"] == "key":
                j["has_key"] = True
            if e["method"] == "key" and e["fp"]:
                j["fps"].add(e["fp"])
                if e["key_known"]:
                    j["verified"] = True

    def _foreign_note(label, loc):
        # 已知密钥在境外公网 IP 成功登录：只提示留意，不算异常。
        if not loc or loc in ("局域网", "组网", "本机") or "/" in label:
            return None
        try:
            addr = ipaddress.ip_address(label)
        except ValueError:
            return None
        if not addr.is_global or _bulk(label):
            return None
        country = loc.split(" · ")[0]
        return "境外" if country and country != "China" else None

    for e in egroups.values():
        e["note"] = None
        if e["ok"] and not e["anomaly"] and e["method"] == "key":
            e["note"] = _foreign_note(e["ip"], e["loc"])

    failed_entries = sorted((fgroups[k] for k in fseq),
                            key=lambda e: -e["count"])[:5]
    ok_entries = sorted((ogroups[k] for k in oseq),
                        key=lambda e: -e["count"])
    for e in ok_entries:
        e["bulk"] = _bulk(e["ip"])
        j = ok_judge.get(e["ip"])
        e["fp"] = None
        e["who"] = None
        e["key_known"] = None
        e["anomaly"] = False
        if j is not None:
            if j["anomaly"]:
                e["anomaly"] = True
                e["key_known"] = False
                e["known"] = False
            elif j["verified"]:
                e["key_known"] = True
                e["known"] = True
            if len(j["fps"]) == 1:
                e["fp"] = next(iter(j["fps"]))[:12]
                if not e["anomaly"]:
                    e["who"] = fp_letters.get(next(iter(j["fps"])))
        e["note"] = None
        if j is not None and j.get("has_key") and not e["anomaly"]:
            e["note"] = _foreign_note(e["ip"], e["loc"])
    event_rows = sorted(egroups.values(), key=lambda e: -e["count"])
    for e in ok_entries:
        e.pop("fp", None)
    # 对外发出的行不带指纹；用户名成功行也带（所有者 2026-11-24 令看板
    # 显示登录用户名；此前以「用户名是半个凭据」为由只给失败行，已废止）。
    # 成功行去掉 fp 后按其余字段（含 user）合并：计数求和、时间取首尾。
    merged = {}
    mseq = []
    for e in event_rows:
        row = {"ip": e["ip"], "loc": e["loc"], "method": e["method"],
               "app": e.get("app"),
               "ok": e["ok"], "known": e["known"],
               "key_known": e["key_known"], "anomaly": e["anomaly"],
               "who": e.get("who"), "note": e["note"], "user": e["user"],
               "bulk": _bulk(e["ip"]), "count": e["count"],
               "first": e["first"], "last": e["last"]}
        if e["ok"]:
            mk = (row["ip"], row["loc"], row["method"], row["ok"],
                  row["known"], row["key_known"], row["anomaly"],
                  row["who"], row["note"], row["bulk"], row["user"])
        else:
            mk = ("fail", len(mseq))
        m = merged.get(mk)
        if m is None:
            merged[mk] = row
            mseq.append(mk)
        else:
            m["count"] += row["count"]
            if row["first"] < m["first"]:
                m["first"] = row["first"]
            if row["last"] > m["last"]:
                m["last"] = row["last"]
    out_events = []
    for mk in mseq:
        r = merged[mk]
        r["first"] = r["first"].strftime("%m-%d %H:%M")
        r["last"] = r["last"].strftime("%m-%d %H:%M")
        out_events.append(r)
    out_events.sort(key=lambda e: -e["count"])
    return (
        [{"ip": e["ip"], "count": e["count"], "loc": e["loc"],
          "known": e["known"], "app": e.get("app")}
         for e in failed_entries],
        ok_entries,
        out_events,
    )


def collect_host_entry(start, end):
    """本机（host 2）的主机安全数据。"""
    failed, failed_ips, ok_ips, _known, events = _host_ssh_stats(
        start, end)
    _key_info = _authorized_key_info()
    _auth_fps = {u: set(fmap) for u, fmap in _key_info.items()}
    _letters = _resolve_key_letters(_key_info, events)
    failed_top, ok_list, ssh_events = _host_ssh_lists(
        failed_ips, ok_ips, _known, events, _auth_fps, _letters)
    _flag_new_ip_logins(ok_list, ssh_events)
    _entry = {
        "window": [start.strftime("%Y-%m-%d %H:%M"),
                   end.strftime("%Y-%m-%d %H:%M")],
        "ssh_failed": failed,
        "ssh_anomaly": sum(e["count"] for e in ssh_events
                           if e.get("anomaly")),
        "ssh_stranger": sum(e["count"] for e in ssh_events
                            if e.get("stranger")),
        "ssh_failed_top": failed_top,
        "ssh_ok": ok_list,
        "ssh_events": ssh_events,
        "panel": _host_panel_stats(start, end),
        "fail2ban": _host_fail2ban_stats(start, end),
        "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
    }
    _entry["anomaly_done"] = _anomaly_done(events, _auth_fps, _letters)
    _ak_alert = _authkeys_change(_auth_fps, _letters)
    if _ak_alert:
        _added_fps = _ak_alert.pop("_added_fps", {})
        _entry["authkeys_alert"] = _ak_alert
        _entry["authkeys_done"] = _authkeys_done(
            _added_fps, _auth_fps, _letters)
    return _entry


def push_host_data(start=None, end=None):
    if start is None or end is None:
        start, end = _host_window()
    entry = collect_host_entry(start, end)
    local = "/tmp/host-host2.json"
    with open(local, "w", encoding="utf-8") as f:
        json.dump(entry, f, ensure_ascii=False, indent=2)
    subprocess.check_call(["scp"] + _HOST_SCP_OPTS + [local, _HOST_DEST])
    print("Host data pushed to host 1 (window %s -> %s)."
          % (entry["window"][0], entry["window"][1]))


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--confirm-location":
        _confirm_location(sys.argv[2])
    elif sys.argv[1:] == ["--list-stranger"]:
        _list_stranger()
    elif len(sys.argv) > 1 and sys.argv[1] == "--push-host":
        # 仅采集并推送主机安全数据，不做存活判断、不发邮件。
        _start = _end = None
        _rest = sys.argv[2:]
        while _rest:
            if _rest[0] == "--start" and len(_rest) > 1:
                _start = datetime.strptime(_rest[1], "%Y-%m-%d %H:%M")
                _rest = _rest[2:]
            elif _rest[0] == "--end" and len(_rest) > 1:
                _end = datetime.strptime(_rest[1], "%Y-%m-%d %H:%M")
                _rest = _rest[2:]
            else:
                _rest = _rest[1:]
        push_host_data(_start, _end)
    else:
        sys.exit("Unsupported arguments")